{{ header }}
<!-- Studio Breadcrumbs -->
<nav class="studio-breadcrumbs-bar" aria-label="breadcrumb">
  <div class="container">
    <ol class="studio-breadcrumbs-list">
      {% for breadcrumb in breadcrumbs %}
        {% if loop.last %}
          <li class="studio-breadcrumb-item active" aria-current="page">{{ breadcrumb.text }}</li>
        {% else %}
          <li class="studio-breadcrumb-item">
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
            <span class="studio-breadcrumb-sep">/</span>
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  </div>
</nav>

<div id="checkout-cart" class="container studio-product-container">
  {% if attention %}
  <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ attention }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}

  <div class="row">
    {{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">
      {{ content_top }}
      <div class="studio-cart-header">
        <h1 class="studio-cart-title">{{ heading_title }}</h1>
        <p class="studio-cart-subtitle">Проверьте выбранные товары перед переходом к оформлению заказа</p>
      </div>

      <form action="{{ action }}" method="post" enctype="multipart/form-data">
        <div class="studio-cart-table-wrap">
          <table class="studio-cart-table">
            <thead>
              <tr>
                <th class="th-img">Товар</th>
                <th class="th-name">Наименование</th>
                <th class="th-model">Артикул</th>
                <th class="th-qty">Количество</th>
                <th class="th-price">Цена</th>
                <th class="th-total">Итого</th>
                <th class="th-remove"></th>
              </tr>
            </thead>
            <tbody>
              {% for product in products %}
              <tr class="cart-item-row">
                <td class="td-img">
                  {% if product.thumb %}
                    <a href="{{ product.href }}" class="cart-thumb-link">
                      <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="cart-item-img" />
                    </a>
                  {% endif %}
                </td>
                <td class="td-name">
                  <a href="{{ product.href }}" class="cart-product-title">{{ product.name }}</a>
                  {% if not product.stock %}
                    <span class="stock-warning">*** Нет на складе</span>
                  {% endif %}
                  {% if product.option %}
                    <div class="cart-item-options">
                      {% for option in product.option %}
                        <span class="option-pill">{{ option.name }}: {{ option.value }}</span>
                      {% endfor %}
                    </div>
                  {% endif %}
                </td>
                <td class="td-model"><span class="cart-model-badge">{{ product.model }}</span></td>
                <td class="td-qty">
                  <div class="cart-qty-inline">
                    <input type="text" name="quantity[{{ product.cart_id }}]" value="{{ product.quantity }}" size="1" class="cart-qty-input" />
                    <button type="submit" data-toggle="tooltip" title="Обновить количество" class="btn-cart-refresh"><i class="fa fa-refresh"></i></button>
                  </div>
                </td>
                <td class="td-price"><span class="cart-price-val">{{ product.price }}</span></td>
                <td class="td-total"><span class="cart-total-val">{{ product.total }}</span></td>
                <td class="td-remove">
                  <button type="button" data-toggle="tooltip" title="Удалить из корзины" class="btn-cart-remove" onclick="cart.remove('{{ product.cart_id }}');"><i class="fa fa-trash-o"></i></button>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </form>

      <div class="studio-cart-footer-row row">
        <div class="col-md-6 col-sm-12">
          <div class="cart-continue-wrap">
            <a href="{{ continue }}" class="btn-studio-secondary">
              <i class="fa fa-arrow-left"></i>
              <span>Продолжить покупки</span>
            </a>
          </div>
        </div>
        <div class="col-md-6 col-sm-12">
          <div class="studio-cart-summary-card">
            <div class="summary-title">Итог заказа</div>
            <div class="summary-rows-list">
              {% for total in totals %}
              <div class="summary-row {% if loop.last %}summary-row--total{% endif %}">
                <span class="summary-label">{{ total.title }}:</span>
                <span class="summary-val">{{ total.text }}</span>
              </div>
              {% endfor %}
            </div>
            <div class="summary-checkout-wrap">
              <a href="{{ checkout }}" class="btn-studio-buy-main btn-block">
                <span>Перейти к оформлению заказа</span>
                <i class="fa fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      </div>

      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>

{{ footer }}
