{{ header }}
<div id="common-home" class="storefront-canvas">
  <div class="container">
    {{ content_top }}

    {# Section 1: Curated Vinyl & CD Releases Carousel #}
    {% if music_recommendations %}
    <section class="storefront-carousel-section" id="section-curated-vinyl">
      <div class="section-header">
        <div class="section-header__title-group">
          <div class="section-eyebrow">Direct from the Crate</div>
          <h2 class="section-title">Curated Vinyl & CD Releases</h2>
          <p class="section-subtitle">Audiophile pressings, original master tapes, and seminal discographies</p>
        </div>
        <div class="carousel-nav-controls">
          <button type="button" class="carousel-nav-btn btn-prev" data-target="#music-carousel" aria-label="Previous Releases">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="carousel-nav-btn btn-next" data-target="#music-carousel" aria-label="Next Releases">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="recommendation-scroll-strip" id="music-carousel">
        {% for product in music_recommendations %}
        <div class="carousel-card-item">
          <div class="vinyl-card" data-product-id="{{ product.product_id }}">
            <div class="vinyl-card__cover-wrap">
              <a href="{{ product.href }}" class="vinyl-card__cover-link" title="{{ product.name }}">
                <img src="{{ product.thumb }}" alt="{{ product.name }}" class="vinyl-card__artwork" loading="lazy" />
              </a>
              {% if product.format_badge %}
                <span class="vinyl-card__format-badge {{ product.format_badge == 'Audio CD' ? 'badge-cd' : 'badge-vinyl' }}">
                  {{ product.format_badge }}
                </span>
              {% endif %}
              <button type="button" class="btn-ai-mode" data-product-id="{{ product.product_id }}" title="Find Similar with AI Mode">
                <svg class="ai-sparkle-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="10" cy="10" r="7"></circle>
                  <line x1="21" y1="21" x2="15" y2="15"></line>
                  <path d="M10 7 L10.8 9.2 L13 10 L10.8 10.8 L10 13 L9.2 10.8 L7 10 L9.2 9.2 Z" fill="#FBBF24" stroke="none"></path>
                </svg>
                <span>AI Mode</span>
              </button>
            </div>
            <div class="vinyl-card__meta-content">
              <div class="vinyl-card__line-artist" title="{{ product.artist }}">{{ product.artist }}</div>
              <div class="vinyl-card__line-title"><a href="{{ product.href }}" title="{{ product.name }}">{{ product.name }}</a></div>
              <div class="vinyl-card__line-submeta">{{ product.meta }}</div>
              <div class="vinyl-card__line-action">
                <span class="vinyl-card__price">{{ product.price }}</span>
                <button type="button" class="btn-vinyl-cart" onclick="cart.add('{{ product.product_id }}', 1);" title="Add to Cart">
                  <i class="fa fa-shopping-cart"></i>
                  <span>Add</span>
                </button>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {# Section 2: Recommended Musical Instruments (Matching Gear) Carousel #}
    {% if gear_recommendations %}
    <section class="storefront-carousel-section" id="section-matching-gear">
      <div class="section-header">
        <div class="section-header__title-group">
          <div class="section-eyebrow">Instruments & Studio Rigs</div>
          <h2 class="section-title">Recommended Musical Instruments (Matching Gear)</h2>
          <p class="section-subtitle">Electric guitars, polyphonic synthesizers, amplifiers, and studio sound equipment</p>
        </div>
        <div class="carousel-nav-controls">
          <button type="button" class="carousel-nav-btn btn-prev" data-target="#gear-carousel" aria-label="Previous Instruments">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="carousel-nav-btn btn-next" data-target="#gear-carousel" aria-label="Next Instruments">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="recommendation-scroll-strip" id="gear-carousel">
        {% for item in gear_recommendations %}
        <div class="carousel-card-item">
          <div class="gear-card" data-product-id="{{ item.product_id }}">
            <div class="gear-card__visual-wrap">
              <a href="{{ item.href }}" class="gear-card__visual-link">
                <img src="{{ item.thumb }}" alt="{{ item.name }}" class="gear-card__artwork" loading="lazy" />
              </a>
              {% if item.brand %}
                <span class="gear-card__brand-pill">{{ item.brand }}</span>
              {% endif %}
            </div>
            <div class="gear-card__content">
              <div class="gear-card__type-tag">{{ item.gear_type }}</div>
              <div class="gear-card__title"><a href="{{ item.href }}">{{ item.name }}</a></div>
              {% if item.sound_style %}
                <div class="gear-card__sound-style"><i class="fa fa-sliders"></i> {{ item.sound_style }}</div>
              {% endif %}
              <div class="gear-card__action-row">
                <span class="gear-card__price">{{ item.price }}</span>
                <button type="button" class="btn-gear-cart" onclick="cart.add('{{ item.product_id }}', 1);" title="Add to Cart">
                  <i class="fa fa-shopping-cart"></i>
                  <span>Add</span>
                </button>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {# Section 3: Popular Categories (5-Column Square Grid) #}
    {% if popular_categories %}
    <section class="storefront-categories-section" id="section-popular-categories">
      <div class="section-header">
        <div class="section-header__title-group">
          <div class="section-eyebrow">Catalog Taxonomies</div>
          <h2 class="section-title">Popular Categories</h2>
          <p class="section-subtitle">Explore physical records, sound processors, and studio axes by specialty</p>
        </div>
      </div>

      <div class="categories-square-grid">
        {% for cat in popular_categories %}
        <a href="{{ cat.href }}" class="category-square-tile">
          <div class="category-square-tile__media">
            <img src="{{ cat.thumb }}" alt="{{ cat.name }}" loading="lazy" />
            <div class="category-square-tile__scrim"></div>
          </div>
          <div class="category-square-tile__caption">
            <h3 class="category-square-tile__title">{{ cat.name }}</h3>
            <span class="category-square-tile__count">{{ cat.count }} items</span>
          </div>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {{ content_bottom }}
  </div>
</div>

{# AI Mode Modal Container for Similar Releases #}
<div class="ai-similar-modal-backdrop" id="aiSimilarModal" style="display: none;">
  <div class="ai-similar-modal-dialog">
    <div class="ai-similar-modal-header">
      <div class="ai-modal-brand-badge">
        <svg class="ai-sparkle-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="10" cy="10" r="7"></circle>
          <line x1="21" y1="21" x2="15" y2="15"></line>
          <path d="M10 7 L10.8 9.2 L13 10 L10.8 10.8 L10 13 L9.2 10.8 L7 10 L9.2 9.2 Z" fill="#FBBF24" stroke="none"></path>
        </svg>
        <span>AI Mode • Sonic Matching Engine</span>
      </div>
      <button type="button" class="ai-modal-close" onclick="closeAiModal();" aria-label="Close modal">&times;</button>
    </div>
    <div class="ai-similar-modal-body" id="aiSimilarModalContent">
      <div class="ai-modal-loader">
        <div class="ai-loader-spinner"></div>
        <p>Analyzing acoustic characteristics and artist vector catalog...</p>
      </div>
    </div>
  </div>
</div>

{{ footer }}