{{ header }}
<div id="product-category" class="container">
	<ul class="breadcrumb">
		{% for breadcrumb in breadcrumbs %}
			<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
		{% endfor %}
	</ul>
	<div class="row">
		{{ column_left }}
		{% if column_left and column_right %}
			{% set class = 'col-sm-6' %}
		{% elseif column_left or column_right %}
			{% set class = 'col-sm-9' %}
		{% else %}
			{% set class = 'col-sm-12' %}
		{% endif %}
		<div id="content" class="{{ class }}">
			{{ content_top }}
			<h1>{{ heading_title }}</h1>
			{% if thumb or description %}
				<div class="row">
					{% if thumb %}
						<div class="col-sm-2"><img src="{{ thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="img-thumbnail" /></div>
					{% endif %}
					{% if description %}
						<div class="col-sm-10">{{ description }}</div>
					{% endif %}
				</div>
				<hr>
			{% endif %}
			{% if categories %}
				<h4>{{ text_refine }}</h4>
				<ul class="category__category-list row-flex">
					{% for category in categories %}
						<li class="category__category-list-item"><a href="{{ category.href }}">{{ category.name }}</a></li>
					{% endfor %}
				</ul>
			{% endif %}
			{% if products %}
				<div class="row">
					<div class="col-md-2 col-sm-6 hidden-xs">
						<div class="btn-group btn-group-sm">
							<button type="button" id="list-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_list }}"><i class="fa fa-th-list"></i></button>
							<button type="button" id="grid-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_grid }}"><i class="fa fa-th"></i></button>
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="form-group"><a href="{{ compare }}" id="compare-total" class="btn btn-link">{{ text_compare }}</a></div>
					</div>
					<div class="col-md-4 col-xs-6">
						<div class="form-group input-group input-group-sm">
							<label class="input-group-addon" for="input-sort">{{ text_sort }}</label>
							<select id="input-sort" class="form-control" onchange="location = this.value;">
								{% for sorts in sorts %}
									{% if sorts.value == '%s-%s'|format(sort, order) %}
										<option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
									{% else %}
										<option value="{{ sorts.href }}">{{ sorts.text }}</option>
									{% endif %}
								{% endfor %}
							</select>
						</div>
					</div>
					<div class="col-md-3 col-xs-6">
						<div class="form-group input-group input-group-sm">
							<label class="input-group-addon" for="input-limit">{{ text_limit }}</label>
							<select id="input-limit" class="form-control" onchange="location = this.value;">
								{% for limits in limits %}
									{% if limits.value == limit %}
										<option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
									{% else %}
										<option value="{{ limits.href }}">{{ limits.text }}</option>
									{% endif %}
								{% endfor %}
							</select>
						</div>
					</div>
				</div>
				<div class="row category-products-grid">
					{% for product in products %}
						<div class="product-layout col-lg-4 col-md-4 col-sm-6 col-xs-12">
							{% if product.is_music %}
								{# Dedicated Vinyl & CD Card Layout #}
								<div class="vinyl-card" data-product-id="{{ product.product_id }}">
									<div class="vinyl-card__cover-wrap">
										<a href="{{ product.href }}" class="vinyl-card__cover-link" title="{{ product.name }}">
											<img src="{{ product.thumb }}" alt="{{ product.name }}" class="vinyl-card__artwork" loading="lazy" />
										</a>
										{% if product.format_badge %}
											<span class="vinyl-card__format-badge {{ product.format_badge == 'Audio CD' ? 'badge-cd' : 'badge-vinyl' }}">
												{{ product.format_badge }}
											</span>
										{% endif %}
										<button type="button" class="btn-ai-mode" data-product-id="{{ product.product_id }}" title="Find Similar with AI Mode">
											<svg class="ai-sparkle-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<circle cx="10" cy="10" r="7"></circle>
												<line x1="21" y1="21" x2="15" y2="15"></line>
												<path d="M10 7 L10.8 9.2 L13 10 L10.8 10.8 L10 13 L9.2 10.8 L7 10 L9.2 9.2 Z" fill="#FBBF24" stroke="none"></path>
											</svg>
											<span>AI Mode</span>
										</button>
									</div>
									<div class="vinyl-card__meta-content">
										<div class="vinyl-card__line-artist" title="{{ product.artist }}">{{ product.artist }}</div>
										<div class="vinyl-card__line-title"><a href="{{ product.href }}" title="{{ product.name }}">{{ product.name }}</a></div>
										<div class="vinyl-card__line-submeta">{{ product.meta }}</div>
										<div class="vinyl-card__line-action">
											<span class="vinyl-card__price">
												{% if not product.special %}
													{{ product.price }}
												{% else %}
													<span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>
												{% endif %}
											</span>
											<button type="button" class="btn-vinyl-cart" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');" title="Add to Cart">
												<i class="fa fa-shopping-cart"></i>
												<span>Add</span>
											</button>
										</div>
									</div>
								</div>
							{% else %}
								{# Gear / Instrument Card Layout #}
								<div class="gear-card" data-product-id="{{ product.product_id }}">
									<div class="gear-card__visual-wrap">
										<a href="{{ product.href }}" class="gear-card__visual-link">
											<img src="{{ product.thumb }}" alt="{{ product.name }}" class="gear-card__artwork" loading="lazy" />
										</a>
										{% if product.brand %}
											<span class="gear-card__brand-pill">{{ product.brand }}</span>
										{% endif %}
									</div>
									<div class="gear-card__content">
										{% if product.gear_type %}
											<div class="gear-card__type-tag">{{ product.gear_type }}</div>
										{% endif %}
										<div class="gear-card__title"><a href="{{ product.href }}">{{ product.name }}</a></div>
										<div class="gear-card__action-row">
											<span class="gear-card__price">
												{% if not product.special %}
													{{ product.price }}
												{% else %}
													<span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>
												{% endif %}
											</span>
											<button type="button" class="btn-gear-cart" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');" title="Add to Cart">
												<i class="fa fa-shopping-cart"></i>
												<span>Add</span>
											</button>
										</div>
									</div>
								</div>
							{% endif %}
						</div>
					{% endfor %}
				</div>
				<div class="category-pagination-row row">
					<div class="col-sm-6 text-left">{{ pagination }}</div>
					<div class="col-sm-6 text-right pagination-results-text">{{ results }}</div>
				</div>
			{% endif %}
			{% if not categories and not products %}
				<div class="empty-category-notice">
					<div class="empty-notice-icon">
						<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<path d="M8 15h8"></path>
							<circle cx="9" cy="9" r="1"></circle>
							<circle cx="15" cy="9" r="1"></circle>
						</svg>
					</div>
					<h3>{{ text_empty }}</h3>
					<p>No products match the selected criteria or price filter range.</p>
					<a href="{{ continue }}" class="btn btn-primary">Browse All Releases</a>
				</div>
			{% endif %}

			{# AI Mode Modal Container for Category Page #}
			<div class="ai-similar-modal-backdrop" id="aiSimilarModal" style="display: none;">
			  <div class="ai-similar-modal-dialog">
			    <div class="ai-similar-modal-header">
			      <div class="ai-modal-brand-badge">
			        <svg class="ai-sparkle-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			          <circle cx="10" cy="10" r="7"></circle>
			          <line x1="21" y1="21" x2="15" y2="15"></line>
			          <path d="M10 7 L10.8 9.2 L13 10 L10.8 10.8 L10 13 L9.2 10.8 L7 10 L9.2 9.2 Z" fill="#FBBF24" stroke="none"></path>
			        </svg>
			        <span>AI Mode • Sonic Matching Engine</span>
			      </div>
			      <button type="button" class="ai-modal-close" onclick="closeAiModal();" aria-label="Close modal">&times;</button>
			    </div>
			    <div class="ai-similar-modal-body" id="aiSimilarModalContent">
			      <div class="ai-modal-loader">
			        <div class="ai-loader-spinner"></div>
			        <p>Analyzing acoustic characteristics and artist vector catalog...</p>
			      </div>
			    </div>
			  </div>
			</div>
			{{ content_bottom }}
		</div>
		{{ column_right }}
	</div>
</div>
{{ footer }}