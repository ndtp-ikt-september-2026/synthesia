<div class="soundnet-tracklist-wrapper soundnet-theme-{{ theme }} soundnet-position-{{ position }}" id="soundnet-tracklist-{{ product_id }}" data-product-id="{{ product_id }}" data-auto-advance="{{ auto_advance }}">
  <!-- Header / Meta Bar -->
  <div class="soundnet-header">
    <div class="soundnet-header-info">
      {% if album_thumb %}
      <div class="soundnet-album-art-wrap">
        <img src="{{ album_thumb }}" alt="{{ album_title }}" class="soundnet-album-art" />
        <div class="soundnet-vinyl-disc" aria-hidden="true"></div>
      </div>
      {% endif %}
      <div class="soundnet-album-details">
        <span class="soundnet-badge-release"><i class="fa fa-music"></i> {{ text_album_release }}</span>
        <h3 class="soundnet-album-title">{{ album_title }}</h3>
        <div class="soundnet-meta-counts">
          <span class="soundnet-meta-item"><i class="fa fa-list-ol"></i> {{ track_count }} {{ text_tracks }}</span>
          {% if album_model %}
          <span class="soundnet-meta-divider">&bull;</span>
          <span class="soundnet-meta-item"><i class="fa fa-barcode"></i> {{ album_model }}</span>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="soundnet-header-actions">
      <button type="button" class="soundnet-btn-play-all js-soundnet-play-first" title="{{ text_play }}">
        <svg class="soundnet-svg-icon" viewBox="0 0 24 24" width="18" height="18"><polygon points="6 3 20 12 6 21 6 3" fill="currentColor"/></svg>
        <span>{{ text_play }}</span>
      </button>
    </div>
  </div>

  <!-- Tracklist Table -->
  <div class="soundnet-table-responsive">
    <table class="soundnet-table">
      <thead>
        <tr>
          <th class="col-num">#</th>
          <th class="col-play"></th>
          <th class="col-title">{{ entry_title|default('Title') }}</th>
          <th class="col-format">Quality</th>
          <th class="col-duration"><i class="fa fa-clock-o"></i></th>
        </tr>
      </thead>
      <tbody>
        {% for track in tracks %}
        <tr class="soundnet-track-row {% if not track.has_preview %}soundnet-track-disabled{% endif %}" 
            id="soundnet-row-{{ track.track_id }}" 
            data-track-id="{{ track.track_id }}" 
            data-audio-url="{{ track.audio_url }}" 
            data-track-num="{{ track.track_num }}" 
            data-title="{{ track.title }}" 
            data-duration="{{ track.duration }}">
          
          <td class="col-num">
            <span class="soundnet-index-text">{{ track.track_num }}</span>
            <div class="soundnet-eq-bars" aria-hidden="true">
              <span class="bar bar-1"></span>
              <span class="bar bar-2"></span>
              <span class="bar bar-3"></span>
              <span class="bar bar-4"></span>
            </div>
          </td>

          <td class="col-play">
            {% if track.has_preview %}
            <button type="button" class="soundnet-btn-play js-soundnet-toggle-track" aria-label="{{ text_play }}: {{ track.title }}" title="{{ text_play }}">
              <svg class="icon-play" viewBox="0 0 24 24" width="16" height="16"><polygon points="6 3 20 12 6 21 6 3" fill="currentColor"/></svg>
              <svg class="icon-pause" viewBox="0 0 24 24" width="16" height="16"><rect x="5" y="3" width="4" height="18" fill="currentColor"/><rect x="15" y="3" width="4" height="18" fill="currentColor"/></svg>
            </button>
            {% else %}
            <span class="soundnet-no-audio" title="{{ text_no_preview }}" data-toggle="tooltip">
              <i class="fa fa-volume-off"></i>
            </span>
            {% endif %}
          </td>

          <td class="col-title">
            <div class="soundnet-track-title-wrap">
              <span class="soundnet-track-title">{{ track.title }}</span>
              {% if not track.has_preview %}
              <span class="soundnet-badge-nopreview">{{ text_no_preview }}</span>
              {% endif %}
            </div>
          </td>

          <td class="col-format">
            <span class="soundnet-format-badge soundnet-format-{{ track.format_badge|lower|replace({' ': ''}) }}">
              {{ track.format_badge }}
            </span>
          </td>

          <td class="col-duration">
            <span class="soundnet-duration-text">{{ track.duration }}</span>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Modern Floating / Sticky Audio Player Bar -->
  <div class="soundnet-player-bar js-soundnet-player-bar soundnet-player-idle" aria-live="polite">
    <div class="soundnet-player-inner">
      <!-- Album & Track Info -->
      <div class="soundnet-player-trackinfo">
        <div class="soundnet-player-art-mini">
          <img src="{{ album_thumb }}" alt="{{ album_title }}" class="soundnet-mini-thumb js-soundnet-player-thumb" />
          <div class="soundnet-mini-disc" aria-hidden="true"></div>
        </div>
        <div class="soundnet-player-titles">
          <div class="soundnet-player-nowplaying">{{ text_now_playing }}</div>
          <div class="soundnet-player-current-title js-soundnet-player-title">—</div>
          <div class="soundnet-player-current-album">{{ album_title }}</div>
        </div>
      </div>

      <!-- Controls & Progress -->
      <div class="soundnet-player-center">
        <div class="soundnet-player-buttons">
          <button type="button" class="soundnet-ctrl-btn js-soundnet-prev" title="{{ text_prev }}" aria-label="{{ text_prev }}">
            <svg viewBox="0 0 24 24" width="18" height="18"><polygon points="19 20 9 12 19 4 19 20" fill="currentColor"/><line x1="5" y1="4" x2="5" y2="20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          </button>
          
          <button type="button" class="soundnet-ctrl-btn soundnet-ctrl-play js-soundnet-main-play" title="{{ text_play }}" aria-label="{{ text_play }}">
            <svg class="icon-play" viewBox="0 0 24 24" width="22" height="22"><polygon points="7 4 20 12 7 20 7 4" fill="currentColor"/></svg>
            <svg class="icon-pause" viewBox="0 0 24 24" width="22" height="22"><rect x="6" y="4" width="3.5" height="16" rx="1" fill="currentColor"/><rect x="14.5" y="4" width="3.5" height="16" rx="1" fill="currentColor"/></svg>
          </button>

          <button type="button" class="soundnet-ctrl-btn js-soundnet-next" title="{{ text_next }}" aria-label="{{ text_next }}">
            <svg viewBox="0 0 24 24" width="18" height="18"><polygon points="5 4 15 12 5 20 5 4" fill="currentColor"/><line x1="19" y1="4" x2="19" y2="20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          </button>
        </div>

        <div class="soundnet-progress-row">
          <span class="soundnet-time soundnet-time-current js-soundnet-current-time">0:00</span>
          <div class="soundnet-progress-bar-wrap js-soundnet-seek-wrap" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
            <div class="soundnet-progress-loaded js-soundnet-progress-loaded"></div>
            <div class="soundnet-progress-bar js-soundnet-progress-bar">
              <span class="soundnet-progress-handle"></span>
            </div>
          </div>
          <span class="soundnet-time soundnet-time-total js-soundnet-total-time">0:00</span>
        </div>
      </div>

      <!-- Volume & Equalizer & Close -->
      <div class="soundnet-player-right">
        <div class="soundnet-player-eq js-soundnet-visualizer" aria-hidden="true">
          <span class="veq-bar bar-1"></span>
          <span class="veq-bar bar-2"></span>
          <span class="veq-bar bar-3"></span>
          <span class="veq-bar bar-4"></span>
          <span class="veq-bar bar-5"></span>
        </div>

        <div class="soundnet-volume-wrap">
          <button type="button" class="soundnet-volume-btn js-soundnet-mute-btn" title="{{ text_mute }}" aria-label="{{ text_mute }}">
            <svg class="icon-vol-up" viewBox="0 0 24 24" width="18" height="18"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <svg class="icon-vol-mute" viewBox="0 0 24 24" width="18" height="18"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor"/><line x1="23" y1="9" x2="17" y2="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="17" y1="9" x2="23" y2="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <div class="soundnet-volume-slider-wrap">
            <input type="range" min="0" max="1" step="0.01" value="0.85" class="soundnet-volume-slider js-soundnet-volume-slider" title="{{ text_volume }}" aria-label="{{ text_volume }}"/>
          </div>
        </div>

        <button type="button" class="soundnet-btn-close js-soundnet-player-close" title="{{ text_close_player }}" aria-label="{{ text_close_player }}">
          <svg viewBox="0 0 24 24" width="18" height="18"><line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </div>
  </div>
</div>
