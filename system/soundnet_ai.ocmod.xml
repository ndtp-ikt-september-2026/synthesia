<?xml version="1.0" encoding="utf-8"?>
<modification>
    <name>SoundNet AI - Audio Track Upload</name>
    <code>soundnet_ai_upload</code>
    <version>1.0.0</version>
    <author>SoundNet AI</author>
    <link>http://127.0.0.1:8000</link>
    <file path="admin/view/template/catalog/product_form.twig">
        <operation>
            <search><![CDATA[<label class="col-sm-2 control-label" for="input-price">{{ entry_price }}</label>]]></search>
            <add position="before" offset="1"><![CDATA[
						<div class="form-group">
							<label class="col-sm-2 control-label" for="input-audio-file"><span data-toggle="tooltip" title="Optional: Upload audio track (MP3, WAV, FLAC, OGG) to extract acoustic features for AI vector search.">Audio Track (SoundNet AI)</span></label>
							<div class="col-sm-10">
								<input type="file" name="audio_file" id="input-audio-file" accept="audio/*,.mp3,.wav,.flac,.ogg" class="form-control"/>
								{% if soundnet_audio_path %}
									<div style="margin-top: 6px;">
										<span class="label label-info"><i class="fa fa-music"></i> Attached Audio File: {{ soundnet_audio_path }}</span>
									</div>
								{% endif %}
							</div>
						</div>
            ]]></add>
        </operation>
    </file>
</modification>
