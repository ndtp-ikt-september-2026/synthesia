{{ header }}
<div id="product-category" class="container">
	<ul class="breadcrumb">
		{% for breadcrumb in breadcrumbs %}
			<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
		{% endfor %}
	</ul>
	<div class="row">
		{{ column_left }}
		{% if column_left and column_right %}
			{% set class = 'col-sm-6' %}
		{% elseif column_left or column_right %}
			{% set class = 'col-sm-9' %}
		{% else %}
			{% set class = 'col-sm-12' %}
		{% endif %}
		<div id="content" class="{{ class }}">
			{{ content_top }}
			<div class="studio-category-hero-card">
				{% if thumb and 'placeholder' not in thumb %}
					<div class="category-hero-thumb">
						<img src="{{ thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="category-hero-img" />
					</div>
				{% endif %}
				<div class="category-hero-meta">
					<h1 class="studio-category-heading">{{ heading_title }}</h1>
					{% if description %}
						<div class="studio-category-desc">{{ description|raw }}</div>
					{% endif %}
				</div>
			</div>

			{% if categories %}
				<div class="studio-refine-block">
					<div class="studio-refine-eyebrow">{{ text_refine }}</div>
					<div class="studio-subcat-pills-wrap">
						{% for category in categories %}
							<a href="{{ category.href }}" class="studio-subcat-pill">
								<span>{{ category.name }}</span>
							</a>
						{% endfor %}
					</div>
				</div>
			{% endif %}
			{% if products %}
				<div class="studio-category-toolbar">
					<div class="studio-category-toolbar__count">
						<span class="toolbar-count-badge">{{ products|length }}</span>
						<span class="toolbar-count-label">товаров на странице</span>
					</div>
					<div class="studio-category-toolbar__controls">
						<div class="studio-select-wrap">
							<label for="input-sort">Сортировка:</label>
							<select id="input-sort" class="studio-select-input" onchange="location = this.value;">
								{% for sorts in sorts %}
									{% if sorts.value == '%s-%s'|format(sort, order) %}
										<option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
									{% else %}
										<option value="{{ sorts.href }}">{{ sorts.text }}</option>
									{% endif %}
								{% endfor %}
							</select>
						</div>
						<div class="studio-select-wrap">
							<label for="input-limit">Показать:</label>
							<select id="input-limit" class="studio-select-input" onchange="location = this.value;">
								{% for limits in limits %}
									{% if limits.value == limit %}
										<option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
									{% else %}
										<option value="{{ limits.href }}">{{ limits.text }}</option>
									{% endif %}
								{% endfor %}
							</select>
						</div>
					</div>
				</div>
				<div class="row category-products-grid">
					{% for product in products %}
						<div class="product-layout col-lg-4 col-md-4 col-sm-6 col-xs-12">
							{% if product.is_music %}
								{# Dedicated Vinyl & CD Card Layout #}
								<div class="vinyl-card" data-product-id="{{ product.product_id }}">
									<div class="vinyl-card__cover-wrap">
										<a href="{{ product.href }}" class="vinyl-card__cover-link" title="{{ product.name }}">
											<img src="{{ product.thumb }}" alt="{{ product.name }}" class="vinyl-card__artwork" loading="lazy" />
										</a>
										{% if product.format_badge %}
											<span class="vinyl-card__format-badge {{ product.format_badge == 'КОМПАКТ-ДИСК CD' ? 'badge-cd' : 'badge-vinyl' }}">
												{{ product.format_badge }}
											</span>
										{% endif %}
										<button type="button" class="btn-ai-mode" data-product-id="{{ product.product_id }}" title="AI Mode • Похожие релизы">
											<svg class="ai-sparkle-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="#a5b4fc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<path d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3l5.8 1.9-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3L12 3z"/>
											</svg>
											<span>AI Mode</span>
										</button>
									</div>
									<div class="vinyl-card__meta-content">
										<div class="vinyl-card__line-artist" title="{{ product.artist }}">{{ product.artist }}</div>
										<div class="vinyl-card__line-title"><a href="{{ product.href }}" title="{{ product.name }}">{{ product.name }}</a></div>
										<div class="vinyl-card__line-submeta">{{ product.meta }}</div>
										<div class="vinyl-card__line-action">
											<span class="vinyl-card__price">
												{% if not product.special %}
													{{ product.price }}
												{% else %}
													<span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>
												{% endif %}
											</span>
											<button type="button" class="btn-vinyl-cart" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');" title="Купить">
												<i class="fa fa-shopping-cart"></i>
												<span>Купить</span>
											</button>
										</div>
									</div>
								</div>
							{% else %}
								{# Gear / Instrument Card Layout #}
								<div class="gear-card" data-product-id="{{ product.product_id }}">
									<div class="gear-card__visual-wrap">
										<a href="{{ product.href }}" class="gear-card__visual-link">
											<img src="{{ product.thumb }}" alt="{{ product.name }}" class="gear-card__artwork" loading="lazy" />
										</a>
										{% if product.brand %}
											<span class="gear-card__brand-pill">{{ product.brand }}</span>
										{% endif %}
									</div>
									<div class="gear-card__content">
										{% if product.gear_type %}
											<div class="gear-card__type-tag">{{ product.gear_type }}</div>
										{% endif %}
										<div class="gear-card__title"><a href="{{ product.href }}">{{ product.name }}</a></div>
										<div class="gear-card__action-row">
											<span class="gear-card__price">
												{% if not product.special %}
													{{ product.price }}
												{% else %}
													<span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>
												{% endif %}
											</span>
											<button type="button" class="btn-gear-cart" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');" title="Купить">
												<i class="fa fa-shopping-cart"></i>
												<span>Купить</span>
											</button>
										</div>
									</div>
								</div>
							{% endif %}
						</div>
					{% endfor %}
				</div>
				<div class="category-pagination-row row">
					<div class="col-sm-6 text-left">{{ pagination }}</div>
					<div class="col-sm-6 text-right pagination-results-text">{{ results }}</div>
				</div>
			{% endif %}
			{% if not products %}
				<div class="empty-category-notice">
					<div class="empty-notice-icon">
						<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<path d="M8 15h8"></path>
							<circle cx="9" cy="9" r="1"></circle>
							<circle cx="15" cy="9" r="1"></circle>
						</svg>
					</div>
					<h3>{{ text_empty }}</h3>
					<p>В данной категории пока нет товаров, соответствующих выбранным параметрам.</p>
					<a href="{{ continue }}" class="btn btn-primary">Смотреть все товары</a>
				</div>
			{% endif %}

			{% include 'default/template/extension/module/soundnet_similar_modal.twig' %}
			{{ content_bottom }}
		</div>
		{{ column_right }}
	</div>
</div>
{{ footer }}