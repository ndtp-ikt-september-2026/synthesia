{% if articles %}
<div class="studio-module-section studio-articles-section">
  <div class="studio-module-header">
    <h3 class="studio-module-title">{{ heading_title }}</h3>
  </div>
  <div class="row category-products-grid">
    {% for article in articles %}
      <div class="product-layout col-lg-3 col-md-4 col-sm-6 col-xs-12">
        <div class="studio-search-card studio-article-card">
          <div class="image">
            <a href="{{ article.href }}"><img src="{{ article.thumb }}" alt="{{ article.name }}" title="{{ article.name }}" class="img-responsive" loading="lazy" /></a>
            {% if article.date_added %}
              <span class="special-discount-badge" style="background: rgba(15, 23, 42, 0.75);"><i class="fa fa-calendar-o"></i> {{ article.date_added }}</span>
            {% endif %}
          </div>
          <div class="caption">
            <h4><a href="{{ article.href }}" title="{{ article.name }}">{{ article.name }}</a></h4>
            <p class="search-desc-snippet">{{ article.description }}</p>
          </div>
          <div class="studio-search-card__actions" style="display: flex; justify-content: space-between; align-items: center;">
            <a href="{{ article.href }}" class="btn-search-cart" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
              <span>{{ button_more|default('Читать') }}</span> <i class="fa fa-arrow-right"></i>
            </a>
            {% if article.viewed %}
              <span style="font-size: 12px; color: #94a3b8;"><i class="fa fa-eye"></i> {{ article.viewed }}</span>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
{% endif %}