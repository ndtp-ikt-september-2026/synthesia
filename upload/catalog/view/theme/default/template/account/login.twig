{{ header }}
<!-- Studio Breadcrumbs -->
<nav class="studio-breadcrumbs-bar" aria-label="breadcrumb">
  <div class="container">
    <ol class="studio-breadcrumbs-list">
      {% for breadcrumb in breadcrumbs %}
        {% if loop.last %}
          <li class="studio-breadcrumb-item active" aria-current="page">{{ breadcrumb.text }}</li>
        {% else %}
          <li class="studio-breadcrumb-item">
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
            <span class="studio-breadcrumb-sep">/</span>
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  </div>
</nav>

<div id="account-login" class="container studio-product-container">
  {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}</div>
  {% endif %}
  {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
  {% endif %}

  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
      {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
      {% set class = 'col-sm-9' %}
    {% else %}
      {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <div class="row">
        <!-- New Customer Card -->
        <div class="col-sm-6" style="margin-bottom: 20px;">
          <div class="studio-content-card" style="height: 100%; display: flex; flex-direction: column;">
            <h2 class="studio-card-section-title">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="20" y1="8" x2="20" y2="14"></line>
                <line x1="23" y1="11" x2="17" y2="11"></line>
              </svg>
              <span>{{ text_new_customer }}</span>
            </h2>
            <p style="font-size: 14px; color: #64748b; line-height: 1.6; margin-bottom: 24px;">
              {{ text_register_account }}
            </p>
            <div style="margin-top: auto;">
              <a href="{{ register }}" class="btn-studio-secondary" style="width: 100%; height: 46px; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; text-decoration: none;">
                <i class="fa fa-user-plus"></i>
                <span>Зарегистрировать аккаунт</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Returning Customer Card -->
        <div class="col-sm-6" style="margin-bottom: 20px;">
          <div class="studio-content-card" style="height: 100%;">
            <h2 class="studio-card-section-title">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                <polyline points="10 17 15 12 10 7"></polyline>
                <line x1="15" y1="12" x2="3" y2="12"></line>
              </svg>
              <span>{{ text_returning_customer }}</span>
            </h2>

            <form action="{{ action }}" method="post" enctype="multipart/form-data" class="studio-form">
              <div class="form-group studio-form-group">
                <label class="control-label studio-label" for="input-email">{{ entry_email }}</label>
                <input type="text" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control studio-input" />
              </div>
              <div class="form-group studio-form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                  <label class="control-label studio-label" for="input-password" style="margin: 0;">{{ entry_password }}</label>
                  <a href="{{ forgotten }}" style="font-size: 12px; color: #2563eb; text-decoration: none;">Забыли пароль?</a>
                </div>
                <input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password }}" id="input-password" class="form-control studio-input" />
              </div>
              <div class="studio-form-actions" style="margin-top: 24px;">
                <button type="submit" class="btn-studio-buy-main" style="width: 100%; height: 46px; font-size: 14px;">
                  <i class="fa fa-sign-in"></i>
                  <span>{{ button_login }}</span>
                </button>
              </div>
              {% if redirect %}
                <input type="hidden" name="redirect" value="{{ redirect }}" />
              {% endif %}
            </form>
          </div>
        </div>
      </div>
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}