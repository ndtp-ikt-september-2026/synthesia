<div id="cart" class="studio-cart-wrap btn-block">
  <button type="button" data-toggle="dropdown" data-loading-text="{{ text_loading }}" class="studio-cart-trigger dropdown-toggle">
    <span class="studio-cart-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
    </span>
    <span class="studio-cart-count-badge">{{ products|length + vouchers|length }}</span>
    <span id="cart-total" class="studio-cart-total-label">{{ text_items }}</span>
  </button>
  <ul class="dropdown-menu dropdown-menu-right studio-cart-dropdown">
    {% if products or vouchers %}
    <li class="studio-cart-dropdown__header">
      <div class="studio-cart-title-row">
        <span class="studio-cart-heading">Корзина</span>
        <span class="studio-cart-badge">{{ products|length + vouchers|length }}</span>
      </div>
    </li>
    <li class="studio-cart-items-wrap">
      <div class="studio-cart-item-list">
        {% for product in products %}
        <div class="studio-cart-card">
          <div class="studio-cart-card__thumb">
            {% if product.thumb %}
              <a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="studio-cart-card__img" /></a>
            {% else %}
              <div class="studio-cart-card__no-img"><i class="fa fa-music"></i></div>
            {% endif %}
          </div>
          <div class="studio-cart-card__info">
            <a href="{{ product.href }}" class="studio-cart-card__title" title="{{ product.name }}">{{ product.name }}</a>
            {% if product.option %}
              <div class="studio-cart-card__options">
                {% for option in product.option %}
                  <span class="studio-cart-card__opt">{{ option.name }}: {{ option.value }}</span>
                {% endfor %}
              </div>
            {% endif %}
            {% if product.recurring %}
              <div class="studio-cart-card__recurring"><small>{{ text_recurring }}: {{ product.recurring }}</small></div>
            {% endif %}
            <div class="studio-cart-card__pricing">
              <span class="studio-cart-card__qty">{{ product.quantity }} ×</span>
              <span class="studio-cart-card__price">{{ product.total }}</span>
            </div>
          </div>
          <div class="studio-cart-card__remove">
            <button type="button" onclick="cart.remove('{{ product.cart_id }}');" title="{{ button_remove }}" class="btn-remove-item" aria-label="{{ button_remove }}">
              <i class="fa fa-trash-o"></i>
            </button>
          </div>
        </div>
        {% endfor %}
        {% for voucher in vouchers %}
        <div class="studio-cart-card">
          <div class="studio-cart-card__thumb">
            <div class="studio-cart-card__no-img"><i class="fa fa-gift"></i></div>
          </div>
          <div class="studio-cart-card__info">
            <span class="studio-cart-card__title">{{ voucher.description }}</span>
            <div class="studio-cart-card__pricing">
              <span class="studio-cart-card__qty">1 ×</span>
              <span class="studio-cart-card__price">{{ voucher.amount }}</span>
            </div>
          </div>
          <div class="studio-cart-card__remove">
            <button type="button" onclick="voucher.remove('{{ voucher.key }}');" title="{{ button_remove }}" class="btn-remove-item" aria-label="{{ button_remove }}">
              <i class="fa fa-trash-o"></i>
            </button>
          </div>
        </div>
        {% endfor %}
      </div>
    </li>
    <li class="studio-cart-footer">
      <div class="studio-cart-totals">
        {% if totals|length == 2 and totals[0].text == totals[1].text %}
          <div class="studio-cart-total-row studio-cart-total-final">
            <span class="total-label">К оплате:</span>
            <span class="total-value">{{ totals[1].text }}</span>
          </div>
        {% else %}
          {% for total in totals %}
          <div class="studio-cart-total-row {{ loop.last ? 'studio-cart-total-final' : '' }}">
            <span class="total-label">{{ total.title }}:</span>
            <span class="total-value">{{ total.text }}</span>
          </div>
          {% endfor %}
        {% endif %}
      </div>
      <div class="studio-cart-buttons-row">
        <a href="{{ cart }}" class="btn-cart-secondary"><i class="fa fa-shopping-bag"></i> {{ text_cart }}</a>
        <a href="{{ checkout }}" class="btn-cart-primary"><i class="fa fa-arrow-right"></i> {{ text_checkout }}</a>
      </div>
    </li>
    {% else %}
    <li class="studio-cart-empty">
      <div class="empty-cart-inner">
        <i class="fa fa-shopping-bag empty-cart-icon"></i>
        <p>{{ text_empty }}</p>
      </div>
    </li>
    {% endif %}
  </ul>
</div>
