{{ header }}{{ column_left }}
<div id="content" class="stopkran-page">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        {% if error_warning %}
        <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        {% if success %}
        <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        <div id="ajax-alert"></div>

        <!-- Master Emergency Banner -->
        <div class="stopkran-emergency-banner">
            <div class="banner-inner">
                <div class="banner-icon">
                    <i class="fa fa-shield fa-3x"></i>
                </div>
                <div class="banner-content">
                    <div class="banner-title">CIRCUIT BREAKER EMERGENCY OVERRIDE</div>
                    <div class="banner-desc">
                        Immediate fail-safe isolation mechanism. Engaging Stop-Kran deactivates ALL active modifications, non-core events, and module settings, flushing modification and system caches to restore OpenCart to an untouchable native baseline.
                    </div>
                </div>
                <div class="banner-actions">
                    <button type="button" id="btn-master-kill" class="btn btn-danger btn-lg stopkran-btn-glow">
                        <i class="fa fa-bolt"></i> {{ button_kill_all }}
                    </button>
                </div>
            </div>
        </div>

        <!-- Stats Overview Strip -->
        <div class="row stats-strip">
            <div class="col-md-3 col-sm-6">
                <div class="stat-card">
                    <div class="stat-icon mod-icon"><i class="fa fa-cogs"></i></div>
                    <div class="stat-body">
                        <div class="stat-value" id="stat-mods">{{ modifications_active }} <span class="stat-sub">/ {{ modifications_total }}</span></div>
                        <div class="stat-label">Active Modifications</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="stat-card">
                    <div class="stat-icon evt-icon"><i class="fa fa-bolt"></i></div>
                    <div class="stat-body">
                        <div class="stat-value" id="stat-events">{{ events_active }} <span class="stat-sub">/ {{ events_total }}</span></div>
                        <div class="stat-label">Active Custom Events</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="stat-card">
                    <div class="stat-icon cache-icon"><i class="fa fa-hdd-o"></i></div>
                    <div class="stat-body">
                        <div class="stat-value" id="stat-cache">{{ mod_cache_size }}</div>
                        <div class="stat-label">OCMOD Storage Cache</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="stat-card">
                    <div class="stat-icon purge-icon"><i class="fa fa-refresh"></i></div>
                    <div class="stat-body">
                        <button type="button" id="btn-purge-cache" class="btn btn-sm btn-info btn-block" style="margin-top: 5px;">
                            <i class="fa fa-recycle"></i> {{ button_purge_cache }}
                        </button>
                        <div class="stat-label" style="margin-top: 4px;">System: {{ system_cache_size }}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Panel with Tabs -->
        <div class="panel panel-default stopkran-panel">
            <div class="panel-heading">
                <ul class="nav nav-tabs stopkran-tabs" id="circuit-tabs">
                    <li class="active"><a href="#tab-bypass" data-toggle="tab"><i class="fa fa-key"></i> {{ tab_settings }}</a></li>
                    <li><a href="#tab-mods" data-toggle="tab"><i class="fa fa-code-fork"></i> {{ tab_modifications }} <span class="badge badge-mod">{{ modifications_active }}</span></a></li>
                    <li><a href="#tab-evts" data-toggle="tab"><i class="fa fa-random"></i> {{ tab_events }} <span class="badge badge-evt">{{ events_active }}</span></a></li>
                    <li><a href="#tab-log" data-toggle="tab"><i class="fa fa-terminal"></i> {{ tab_logs }}</a></li>
                </ul>
            </div>
            <div class="panel-body">
                <div class="tab-content">
                    <!-- Tab 1: Emergency Bypass Configuration -->
                    <div class="tab-pane active" id="tab-bypass">
                        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="input-status">{{ entry_status }}</label>
                                <div class="col-sm-9">
                                    <select name="module_stopkran_status" id="input-status" class="form-control">
                                        {% if module_stopkran_status %}
                                        <option value="1" selected="selected">{{ text_enabled }}</option>
                                        <option value="0">{{ text_disabled }}</option>
                                        {% else %}
                                        <option value="1">{{ text_enabled }}</option>
                                        <option value="0" selected="selected">{{ text_disabled }}</option>
                                        {% endif %}
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="input-secret-token">
                                    <span data-toggle="tooltip" title="{{ help_secret_token }}">{{ entry_secret_token }}</span>
                                </label>
                                <div class="col-sm-9">
                                    <div class="input-group">
                                        <input type="text" name="module_stopkran_secret_token" value="{{ module_stopkran_secret_token }}" id="input-secret-token" class="form-control font-mono" required />
                                        <span class="input-group-btn">
                                            <button type="button" id="btn-gen-token" class="btn btn-default" data-toggle="tooltip" title="{{ button_generate_token }}">
                                                <i class="fa fa-random"></i>
                                            </button>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <hr style="border-color: #263345;" />

                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span data-toggle="tooltip" title="{{ help_bypass_url }}">{{ entry_bypass_url_admin }}</span>
                                </label>
                                <div class="col-sm-9">
                                    <div class="input-group">
                                        <input type="text" readonly value="{{ bypass_url_admin }}" id="bypass-admin-url" class="form-control font-mono copy-target" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-primary btn-copy" data-target="#bypass-admin-url">
                                                <i class="fa fa-clipboard"></i> <span class="copy-lbl">{{ text_copy_url }}</span>
                                            </button>
                                        </span>
                                    </div>
                                    <span class="help-block text-muted">Use this direct link if the Admin CP becomes inaccessible or encounters a blank white screen.</span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span data-toggle="tooltip" title="{{ help_bypass_url }}">{{ entry_bypass_url_catalog }}</span>
                                </label>
                                <div class="col-sm-9">
                                    <div class="input-group">
                                        <input type="text" readonly value="{{ bypass_url_catalog }}" id="bypass-catalog-url" class="form-control font-mono copy-target" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-primary btn-copy" data-target="#bypass-catalog-url">
                                                <i class="fa fa-clipboard"></i> <span class="copy-lbl">{{ text_copy_url }}</span>
                                            </button>
                                        </span>
                                    </div>
                                    <span class="help-block text-muted">Public storefront bypass trigger. Operates without sessions or cookies.</span>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Tab 2: Modifications (OCMOD) Table with Instant AJAX Switches -->
                    <div class="tab-pane" id="tab-mods">
                        <div class="table-responsive">
                            <table class="table table-hover stopkran-table">
                                <thead>
                                    <tr>
                                        <th>{{ column_name }}</th>
                                        <th>{{ column_code }}</th>
                                        <th>{{ column_author }}</th>
                                        <th>{{ column_version }}</th>
                                        <th class="text-center" style="width: 130px;">{{ column_status }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% if modifications %}
                                    {% for mod in modifications %}
                                    <tr id="mod-row-{{ mod.modification_id }}" class="{% if not mod.status %}row-inactive{% endif %}">
                                        <td><strong>{{ mod.name }}</strong></td>
                                        <td><code>{{ mod.code }}</code></td>
                                        <td>{{ mod.author }}</td>
                                        <td><span class="label label-default">{{ mod.version }}</span></td>
                                        <td class="text-center">
                                            <label class="switch">
                                                <input type="checkbox" class="ajax-toggle-mod" data-id="{{ mod.modification_id }}" {% if mod.status %}checked{% endif %}>
                                                <span class="slider round"></span>
                                            </label>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                    {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">{{ text_no_modifications }}</td>
                                    </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tab 3: System Events Table with Instant AJAX Switches -->
                    <div class="tab-pane" id="tab-evts">
                        <div class="table-responsive">
                            <table class="table table-hover stopkran-table">
                                <thead>
                                    <tr>
                                        <th>{{ column_code }}</th>
                                        <th>{{ column_trigger }}</th>
                                        <th>{{ column_action }}</th>
                                        <th class="text-center" style="width: 130px;">{{ column_status }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% if events %}
                                    {% for evt in events %}
                                    <tr id="evt-row-{{ evt.event_id }}" class="{% if not evt.status %}row-inactive{% endif %}">
                                        <td><code>{{ evt.code }}</code></td>
                                        <td class="font-mono text-cyan" style="font-size: 12px;">{{ evt.trigger }}</td>
                                        <td class="font-mono" style="font-size: 12px;">{{ evt.action }}</td>
                                        <td class="text-center">
                                            <label class="switch">
                                                <input type="checkbox" class="ajax-toggle-evt" data-id="{{ evt.event_id }}" {% if evt.status %}checked{% endif %}>
                                                <span class="slider round"></span>
                                            </label>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                    {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">{{ text_no_events }}</td>
                                    </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tab 4: Crash Diagnostics Log -->
                    <div class="tab-pane" id="tab-log">
                        <div class="log-header">
                            <span class="log-title"><i class="fa fa-file-text-o"></i> <code>system/storage/logs/stopkran_crash.log</code></span>
                            <div class="pull-right">
                                <button type="button" id="btn-clear-log" class="btn btn-sm btn-danger"><i class="fa fa-trash"></i> {{ button_clear_log }}</button>
                                <a href="javascript:location.reload()" class="btn btn-sm btn-default"><i class="fa fa-refresh"></i> {{ button_refresh }}</a>
                            </div>
                        </div>
                        <div class="terminal-box" id="crash-log-container">
                            {% if has_logs %}
                            {% for line in log_entries %}
                            <div class="terminal-line">{{ line }}</div>
                            {% endfor %}
                            {% else %}
                            <div class="terminal-line text-muted">{{ text_no_logs }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* SoundNet Stop-Kran Industrial Aesthetic */
.stopkran-page {
    background-color: #0c121e;
    min-height: 100vh;
}
.stopkran-emergency-banner {
    background: linear-gradient(135deg, #1e1014 0%, #2a1117 50%, #170b0f 100%);
    border: 1px solid #7f1d1d;
    border-left: 6px solid #ef4444;
    border-radius: 8px;
    padding: 24px;
    margin-bottom: 22px;
    box-shadow: 0 10px 30px rgba(239, 68, 68, 0.15);
}
.banner-inner {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
}
.banner-icon {
    color: #ef4444;
    padding: 5px;
}
.banner-content {
    flex: 1;
    min-width: 280px;
}
.banner-title {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #fca5a5;
    margin-bottom: 6px;
    text-transform: uppercase;
}
.banner-desc {
    font-size: 13px;
    color: #cbd5e1;
    line-height: 1.5;
}
.stopkran-btn-glow {
    background: #dc2626 !important;
    border-color: #b91c1c !important;
    font-weight: 800;
    letter-spacing: 0.5px;
    padding: 14px 26px;
    border-radius: 6px;
    box-shadow: 0 0 20px rgba(220, 38, 38, 0.6);
    transition: all 0.25s ease;
    white-space: nowrap;
}
.stopkran-btn-glow:hover {
    background: #b91c1c !important;
    transform: scale(1.02);
    box-shadow: 0 0 28px rgba(239, 68, 68, 0.8);
}
.stats-strip {
    margin-bottom: 15px;
}
.stat-card {
    background: #131c2d;
    border: 1px solid #1e2d42;
    border-radius: 8px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 15px;
}
.stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
}
.mod-icon { background: rgba(56, 189, 248, 0.12); color: #38bdf8; }
.evt-icon { background: rgba(168, 85, 247, 0.12); color: #c084fc; }
.cache-icon { background: rgba(245, 158, 11, 0.12); color: #fbbf24; }
.purge-icon { background: rgba(16, 185, 129, 0.12); color: #34d399; }
.stat-value {
    font-size: 22px;
    font-weight: 700;
    color: #f1f5f9;
}
.stat-sub {
    font-size: 14px;
    color: #64748b;
    font-weight: 400;
}
.stat-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #94a3b8;
    margin-top: 2px;
}
.stopkran-panel {
    background: #111927;
    border: 1px solid #1e2d42;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
}
.stopkran-panel .panel-heading {
    background: #0f1624;
    border-bottom: 1px solid #1e2d42;
    padding: 0;
}
.stopkran-tabs {
    border-bottom: none;
}
.stopkran-tabs > li > a {
    color: #94a3b8;
    border-radius: 0;
    border: none;
    padding: 14px 22px;
    font-weight: 600;
    font-size: 13px;
    transition: all 0.2s;
}
.stopkran-tabs > li.active > a,
.stopkran-tabs > li.active > a:hover,
.stopkran-tabs > li.active > a:focus {
    background: #111927;
    color: #38bdf8;
    border: none;
    border-bottom: 3px solid #38bdf8;
}
.badge-mod { background: #0284c7; }
.badge-evt { background: #7c3aed; }
.font-mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace !important;
}
.text-cyan { color: #38bdf8; }
.stopkran-table {
    color: #e2e8f0;
}
.stopkran-table > thead > tr > th {
    background: #0c121e;
    color: #94a3b8;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    border-bottom: 1px solid #1e2d42;
    padding: 12px 14px;
}
.stopkran-table > tbody > tr > td {
    border-top: 1px solid #192538;
    padding: 12px 14px;
    vertical-align: middle;
}
.stopkran-table tr.row-inactive td {
    opacity: 0.55;
    background: rgba(0, 0, 0, 0.15);
}
/* Toggle Switch Styling */
.switch {
    position: relative;
    display: inline-block;
    width: 48px;
    height: 24px;
    margin: 0;
}
.switch input { opacity: 0; width: 0; height: 0; }
.slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #334155;
    transition: .3s;
    border-radius: 24px;
}
.slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: .3s;
    border-radius: 50%;
}
input:checked + .slider {
    background-color: #10b981;
}
input:checked + .slider:before {
    transform: translateX(24px);
}
/* Terminal Log Window */
.log-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}
.log-title {
    color: #94a3b8;
    font-size: 13px;
}
.terminal-box {
    background: #050811;
    border: 1px solid #192333;
    border-radius: 6px;
    padding: 16px;
    max-height: 420px;
    overflow-y: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    color: #cbd5e1;
    line-height: 1.6;
}
.terminal-line {
    white-space: pre-wrap;
    word-break: break-all;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    padding: 3px 0;
}
</style>

<script>
$(document).ready(function() {
    // 1. Copy URL Helper
    $('.btn-copy').on('click', function() {
        var targetSelector = $(this).data('target');
        var input = $(targetSelector);
        input.select();
        document.execCommand('copy');

        var btn = $(this);
        var oldHtml = btn.html();
        btn.html('<i class="fa fa-check"></i> {{ text_copied }}');
        setTimeout(function() {
            btn.html(oldHtml);
        }, 2000);
    });

    // 2. Generate Random Token
    $('#btn-gen-token').on('click', function() {
        var chars = '0123456789abcdef';
        var token = '';
        for (var i = 0; i < 32; i++) {
            token += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        $('#input-secret-token').val(token);
        var adminBase = '{{ bypass_url_admin }}'.split('?')[0];
        var catalogBase = '{{ bypass_url_catalog }}'.split('?')[0];
        $('#bypass-admin-url').val(adminBase + '?stopkran_kill_all=' + token);
        $('#bypass-catalog-url').val(catalogBase + '?stopkran_kill_all=' + token);
    });

    // 3. Master Emergency Stop-Kran (Total Blackout)
    $('#btn-master-kill').on('click', function() {
        if (!confirm('{{ text_confirm_blackout }}')) {
            return;
        }

        var btn = $(this);
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> ENGAGING BLACKOUT...');

        $.ajax({
            url: '{{ url_kill_all }}',
            type: 'post',
            dataType: 'json',
            success: function(json) {
                if (json['error']) {
                    alert(json['error']);
                    btn.prop('disabled', false).html('<i class="fa fa-bolt"></i> {{ button_kill_all }}');
                } else {
                    $('#ajax-alert').html('<div class="alert alert-danger alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['message'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                    setTimeout(function() {
                        location.reload();
                    }, 1200);
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                btn.prop('disabled', false).html('<i class="fa fa-bolt"></i> {{ button_kill_all }}');
            }
        });
    });

    // 4. AJAX Toggle Modification
    $('.ajax-toggle-mod').on('change', function() {
        var chk = $(this);
        var modId = chk.data('id');
        var newStatus = chk.is(':checked') ? 1 : 0;
        var row = $('#mod-row-' + modId);

        chk.prop('disabled', true);

        $.ajax({
            url: '{{ url_toggle_modification }}',
            type: 'post',
            data: { modification_id: modId, status: newStatus },
            dataType: 'json',
            success: function(json) {
                chk.prop('disabled', false);
                if (json['error']) {
                    alert(json['error']);
                    chk.prop('checked', !newStatus);
                } else {
                    if (newStatus) {
                        row.removeClass('row-inactive');
                    } else {
                        row.addClass('row-inactive');
                    }
                }
            },
            error: function() {
                chk.prop('disabled', false);
                chk.prop('checked', !newStatus);
            }
        });
    });

    // 5. AJAX Toggle Event
    $('.ajax-toggle-evt').on('change', function() {
        var chk = $(this);
        var evtId = chk.data('id');
        var newStatus = chk.is(':checked') ? 1 : 0;
        var row = $('#evt-row-' + evtId);

        chk.prop('disabled', true);

        $.ajax({
            url: '{{ url_toggle_event }}',
            type: 'post',
            data: { event_id: evtId, status: newStatus },
            dataType: 'json',
            success: function(json) {
                chk.prop('disabled', false);
                if (json['error']) {
                    alert(json['error']);
                    chk.prop('checked', !newStatus);
                } else {
                    if (newStatus) {
                        row.removeClass('row-inactive');
                    } else {
                        row.addClass('row-inactive');
                    }
                }
            },
            error: function() {
                chk.prop('disabled', false);
                chk.prop('checked', !newStatus);
            }
        });
    });

    // 6. Purge Caches Button
    $('#btn-purge-cache').on('click', function() {
        var btn = $(this);
        var oldHtml = btn.html();
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Purging...');

        $.ajax({
            url: '{{ url_purge_cache }}',
            type: 'post',
            dataType: 'json',
            success: function(json) {
                btn.prop('disabled', false).html(oldHtml);
                if (json['success']) {
                    $('#stat-cache').text('0.00 B');
                    $('#ajax-alert').html('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['message'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                } else if (json['error']) {
                    alert(json['error']);
                }
            },
            error: function() {
                btn.prop('disabled', false).html(oldHtml);
            }
        });
    });

    // 7. Clear Log Button
    $('#btn-clear-log').on('click', function() {
        if (!confirm('Clear crash diagnostics log?')) {
            return;
        }

        var btn = $(this);
        btn.prop('disabled', true);

        $.ajax({
            url: '{{ url_clear_log }}',
            type: 'post',
            dataType: 'json',
            success: function(json) {
                btn.prop('disabled', false);
                if (json['success']) {
                    $('#crash-log-container').html('<div class="terminal-line text-muted">{{ text_no_logs }}</div>');
                } else if (json['error']) {
                    alert(json['error']);
                }
            },
            error: function() {
                btn.prop('disabled', false);
            }
        });
    });
});
</script>
{{ footer }}
