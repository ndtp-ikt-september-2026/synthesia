{{ header }}{{ column_left }}
<div id="content" class="stopkran-console">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary stopkran-btn-flat"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default stopkran-btn-flat"><i class="fa fa-reply"></i></a>
            </div>
            <h1 class="stopkran-title">{{ heading_title }}</h1>
            <ul class="breadcrumb stopkran-breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        {% if error_warning %}
        <div class="alert alert-danger stopkran-alert"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        {% if success %}
        <div class="alert alert-success stopkran-alert"><i class="fa fa-check-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        <div id="ajax-alert"></div>

        <!-- Master Emergency Override Station (Flat Industrial) -->
        <div class="stopkran-breaker-bay">
            <div class="breaker-inner">
                <div class="breaker-status-col">
                    <span class="breaker-indicator-light"></span>
                    <div class="breaker-indicator-label">CIRCUIT BREAKER: ARMED</div>
                </div>
                <div class="breaker-spec-col">
                    <div class="breaker-heading">FAIL-SAFE TOTAL BLACKOUT OVERRIDE</div>
                    <div class="breaker-subtext">
                        Direct mechanical fallback. Deactivates all modifications, non-core events, and module statuses in MySQL, then unlinks all storage caches. Instantly reverts OpenCart to an unmodified core state.
                    </div>
                </div>
                <div class="breaker-action-col">
                    <button type="button" id="btn-master-kill" class="btn btn-danger stopkran-kill-switch">
                        <span class="kill-icon"><i class="fa fa-ban"></i></span>
                        <span class="kill-text">{{ button_kill_all }}</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Telemetry Stats Strip (Flat Tabular Grid) -->
        <div class="row stopkran-telemetry-row">
            <div class="col-md-3 col-sm-6">
                <div class="telemetry-cell">
                    <div class="telemetry-header">
                        <span class="telemetry-title">OCMOD Modifications</span>
                        <span class="telemetry-tag">ACTIVE / TOTAL</span>
                    </div>
                    <div class="telemetry-data">
                        <span class="telemetry-num text-highlight" id="stat-mods">{{ modifications_active }}</span>
                        <span class="telemetry-divider">/</span>
                        <span class="telemetry-denom">{{ modifications_total }}</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="telemetry-cell">
                    <div class="telemetry-header">
                        <span class="telemetry-title">Custom Events</span>
                        <span class="telemetry-tag">NON-CORE</span>
                    </div>
                    <div class="telemetry-data">
                        <span class="telemetry-num text-signal" id="stat-events">{{ events_active }}</span>
                        <span class="telemetry-divider">/</span>
                        <span class="telemetry-denom">{{ events_total }}</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="telemetry-cell">
                    <div class="telemetry-header">
                        <span class="telemetry-title">Storage Cache (OCMOD)</span>
                        <span class="telemetry-tag">DISK OCCUPANCY</span>
                    </div>
                    <div class="telemetry-data">
                        <span class="telemetry-num" id="stat-cache">{{ mod_cache_size }}</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="telemetry-cell">
                    <div class="telemetry-header">
                        <span class="telemetry-title">Cache Maintenance</span>
                        <span class="telemetry-tag">SYS: {{ system_cache_size }}</span>
                    </div>
                    <div class="telemetry-action">
                        <button type="button" id="btn-purge-cache" class="btn btn-block stopkran-btn-purge">
                            <i class="fa fa-recycle"></i> {{ button_purge_cache }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Workspace Deck (Flat Structural Panels) -->
        <div class="stopkran-deck">
            <div class="deck-header">
                <ul class="nav nav-tabs stopkran-nav-tabs" id="circuit-tabs">
                    <li class="active"><a href="#tab-bypass" data-toggle="tab"><i class="fa fa-shield"></i> {{ tab_settings }}</a></li>
                    <li><a href="#tab-mods" data-toggle="tab"><i class="fa fa-code-fork"></i> {{ tab_modifications }} <span class="flat-chip chip-cyan">{{ modifications_active }}</span></a></li>
                    <li><a href="#tab-evts" data-toggle="tab"><i class="fa fa-bolt"></i> {{ tab_events }} <span class="flat-chip chip-amber">{{ events_active }}</span></a></li>
                    <li><a href="#tab-log" data-toggle="tab"><i class="fa fa-terminal"></i> {{ tab_logs }}</a></li>
                </ul>
            </div>
            <div class="deck-body">
                <div class="tab-content">
                    <!-- Tab 1: Emergency Bypass Configuration -->
                    <div class="tab-pane active" id="tab-bypass">
                        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal stopkran-form">
                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="input-status">{{ entry_status }}</label>
                                <div class="col-sm-9">
                                    <select name="module_stopkran_status" id="input-status" class="form-control stopkran-input">
                                        {% if module_stopkran_status %}
                                        <option value="1" selected="selected">{{ text_enabled }}</option>
                                        <option value="0">{{ text_disabled }}</option>
                                        {% else %}
                                        <option value="1">{{ text_enabled }}</option>
                                        <option value="0" selected="selected">{{ text_disabled }}</option>
                                        {% endif %}
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="input-secret-token">
                                    <span data-toggle="tooltip" title="{{ help_secret_token }}">{{ entry_secret_token }}</span>
                                </label>
                                <div class="col-sm-9">
                                    <div class="input-group">
                                        <input type="text" name="module_stopkran_secret_token" value="{{ module_stopkran_secret_token }}" id="input-secret-token" class="form-control font-mono stopkran-input" required />
                                        <span class="input-group-btn">
                                            <button type="button" id="btn-gen-token" class="btn stopkran-input-btn" data-toggle="tooltip" title="{{ button_generate_token }}">
                                                <i class="fa fa-random"></i> {{ button_generate_token }}
                                            </button>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="section-divider"></div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span data-toggle="tooltip" title="{{ help_bypass_url }}">{{ entry_bypass_url_admin }}</span>
                                </label>
                                <div class="col-sm-9">
                                    <div class="input-group">
                                        <input type="text" readonly value="{{ bypass_url_admin }}" id="bypass-admin-url" class="form-control font-mono stopkran-input copy-target" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn stopkran-btn-copy btn-copy" data-target="#bypass-admin-url">
                                                <i class="fa fa-clipboard"></i> <span class="copy-lbl">{{ text_copy_url }}</span>
                                            </button>
                                        </span>
                                    </div>
                                    <div class="form-caption">Direct admin rollback link. Operates without sessions or cookies.</div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span data-toggle="tooltip" title="{{ help_bypass_url }}">{{ entry_bypass_url_catalog }}</span>
                                </label>
                                <div class="col-sm-9">
                                    <div class="input-group">
                                        <input type="text" readonly value="{{ bypass_url_catalog }}" id="bypass-catalog-url" class="form-control font-mono stopkran-input copy-target" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn stopkran-btn-copy btn-copy" data-target="#bypass-catalog-url">
                                                <i class="fa fa-clipboard"></i> <span class="copy-lbl">{{ text_copy_url }}</span>
                                            </button>
                                        </span>
                                    </div>
                                    <div class="form-caption">Storefront emergency endpoint for unauthenticated recovery triggers.</div>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Tab 2: Modifications Table (Flat Industrial Grid) -->
                    <div class="tab-pane" id="tab-mods">
                        <div class="table-responsive">
                            <table class="table stopkran-data-table">
                                <thead>
                                    <tr>
                                        <th>{{ column_name }}</th>
                                        <th>{{ column_code }}</th>
                                        <th>{{ column_author }}</th>
                                        <th>{{ column_version }}</th>
                                        <th class="text-center" style="width: 140px;">{{ column_status }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% if modifications %}
                                    {% for mod in modifications %}
                                    <tr id="mod-row-{{ mod.modification_id }}" class="{% if not mod.status %}row-deactivated{% endif %}">
                                        <td class="cell-title">{{ mod.name }}</td>
                                        <td><span class="cell-code font-mono">{{ mod.code }}</span></td>
                                        <td class="cell-meta">{{ mod.author }}</td>
                                        <td><span class="flat-chip">{{ mod.version }}</span></td>
                                        <td class="text-center">
                                            <div class="rocker-switch-wrap">
                                                <input type="checkbox" id="toggle-mod-{{ mod.modification_id }}" class="rocker-input ajax-toggle-mod" data-id="{{ mod.modification_id }}" {% if mod.status %}checked{% endif %}>
                                                <label for="toggle-mod-{{ mod.modification_id }}" class="rocker-label">
                                                    <span class="rocker-off">OFF</span>
                                                    <span class="rocker-on">ON</span>
                                                    <span class="rocker-nub"></span>
                                                </label>
                                            </div>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                    {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center cell-empty">{{ text_no_modifications }}</td>
                                    </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tab 3: System Events Table -->
                    <div class="tab-pane" id="tab-evts">
                        <div class="table-responsive">
                            <table class="table stopkran-data-table">
                                <thead>
                                    <tr>
                                        <th>{{ column_code }}</th>
                                        <th>{{ column_trigger }}</th>
                                        <th>{{ column_action }}</th>
                                        <th class="text-center" style="width: 140px;">{{ column_status }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% if events %}
                                    {% for evt in events %}
                                    <tr id="evt-row-{{ evt.event_id }}" class="{% if not evt.status %}row-deactivated{% endif %}">
                                        <td><span class="cell-code font-mono">{{ evt.code }}</span></td>
                                        <td class="font-mono text-spec">{{ evt.trigger }}</td>
                                        <td class="font-mono text-meta">{{ evt.action }}</td>
                                        <td class="text-center">
                                            <div class="rocker-switch-wrap">
                                                <input type="checkbox" id="toggle-evt-{{ evt.event_id }}" class="rocker-input ajax-toggle-evt" data-id="{{ evt.event_id }}" {% if evt.status %}checked{% endif %}>
                                                <label for="toggle-evt-{{ evt.event_id }}" class="rocker-label">
                                                    <span class="rocker-off">OFF</span>
                                                    <span class="rocker-on">ON</span>
                                                    <span class="rocker-nub"></span>
                                                </label>
                                            </div>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                    {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center cell-empty">{{ text_no_events }}</td>
                                    </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tab 4: Crash Diagnostics Log (Monospace Telemetry) -->
                    <div class="tab-pane" id="tab-log">
                        <div class="log-control-bar">
                            <span class="log-file-label font-mono">system/storage/logs/stopkran_crash.log</span>
                            <div class="pull-right">
                                <button type="button" id="btn-clear-log" class="btn stopkran-btn-flat btn-danger"><i class="fa fa-trash"></i> {{ button_clear_log }}</button>
                                <a href="javascript:location.reload()" class="btn stopkran-btn-flat btn-default"><i class="fa fa-refresh"></i> {{ button_refresh }}</a>
                            </div>
                        </div>
                        <div class="stopkran-terminal" id="crash-log-container">
                            {% if has_logs %}
                            {% for line in log_entries %}
                            <div class="terminal-record font-mono">{{ line }}</div>
                            {% endfor %}
                            {% else %}
                            <div class="terminal-empty font-mono">{{ text_no_logs }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* ==========================================================================
   SoundNet Stop-Kran // Flat Dieter Rams + Swiss International Design
   Zero Gradients. Zero Shadows. Zero Rounding Bloat. 100% Honest Functionality.
   ========================================================================== */

.stopkran-console {
    background: #0d1117;
    color: #e6edf3;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    min-height: 100vh;
    padding-bottom: 40px;
}

.stopkran-title {
    font-size: 20px !important;
    font-weight: 700 !important;
    letter-spacing: -0.01em;
    color: #f0f6fc;
}

.stopkran-breadcrumb > li > a {
    color: #8b949e;
}

.stopkran-alert {
    border-radius: 0 !important;
    border: 1px solid #30363d !important;
    box-shadow: none !important;
    font-size: 13px;
    padding: 12px 16px;
}
.alert-danger.stopkran-alert {
    background: #1c1214;
    border-color: #8b1820 !important;
    color: #f85149;
}
.alert-success.stopkran-alert {
    background: #0d1e16;
    border-color: #238636 !important;
    color: #3fb950;
}

/* Master Breaker Station (Physical Hazard Framing) */
.stopkran-breaker-bay {
    background: #141820;
    border: 1px solid #30363d;
    border-left: 6px solid #da3633;
    border-radius: 0;
    box-shadow: none;
    padding: 20px 24px;
    margin-bottom: 20px;
}
.breaker-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
}
.breaker-status-col {
    display: flex;
    align-items: center;
    gap: 10px;
    border-right: 1px solid #21262d;
    padding-right: 20px;
}
.breaker-indicator-light {
    display: inline-block;
    width: 12px;
    height: 12px;
    background: #da3633;
    border: 1px solid #f85149;
    border-radius: 0;
}
.breaker-indicator-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f85149;
    font-family: ui-monospace, Consolas, monospace;
}
.breaker-spec-col {
    flex: 1;
    min-width: 280px;
}
.breaker-heading {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #f0f6fc;
    margin-bottom: 4px;
}
.breaker-subtext {
    font-size: 13px;
    color: #8b949e;
    line-height: 1.5;
}
.stopkran-kill-switch {
    background: #da3633 !important;
    color: #ffffff !important;
    border: 2px solid #b62324 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    font-size: 13px !important;
    font-weight: 800 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase;
    padding: 12px 22px !important;
    transition: background-color 0.1s ease, transform 0.08s ease;
    display: inline-flex;
    align-items: center;
    gap: 10px;
}
.stopkran-kill-switch:hover {
    background: #b62324 !important;
}
.stopkran-kill-switch:active {
    transform: translateY(1px);
}

/* Telemetry Grid */
.stopkran-telemetry-row {
    margin-bottom: 20px;
}
.telemetry-cell {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 0;
    padding: 14px 18px;
    margin-bottom: 15px;
    height: 84px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.telemetry-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.telemetry-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #8b949e;
}
.telemetry-tag {
    font-size: 10px;
    font-family: ui-monospace, Consolas, monospace;
    color: #6e7681;
}
.telemetry-data {
    font-family: ui-monospace, Consolas, monospace;
    display: flex;
    align-items: baseline;
    gap: 6px;
}
.telemetry-num {
    font-size: 22px;
    font-weight: 700;
    color: #f0f6fc;
}
.telemetry-divider {
    color: #484f58;
    font-size: 16px;
}
.telemetry-denom {
    color: #8b949e;
    font-size: 15px;
}
.text-highlight { color: #58a6ff; }
.text-signal { color: #d29922; }

.stopkran-btn-purge {
    background: #21262d !important;
    border: 1px solid #363b42 !important;
    border-radius: 0 !important;
    color: #c9d1d9 !important;
    font-size: 12px !important;
    font-weight: 600;
    box-shadow: none !important;
    padding: 6px 12px !important;
    text-align: center;
    transition: background-color 0.1s ease;
}
.stopkran-btn-purge:hover {
    background: #30363d !important;
    color: #ffffff !important;
}

/* Structural Deck */
.stopkran-deck {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 0;
    box-shadow: none;
}
.deck-header {
    background: #0d1117;
    border-bottom: 1px solid #30363d;
}
.stopkran-nav-tabs {
    border-bottom: none;
    margin: 0;
}
.stopkran-nav-tabs > li > a {
    background: transparent;
    border: none !important;
    border-right: 1px solid #21262d !important;
    border-radius: 0 !important;
    color: #8b949e;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 14px 20px;
    margin: 0;
    transition: color 0.1s ease;
}
.stopkran-nav-tabs > li > a:hover {
    color: #f0f6fc;
    background: #161b22;
}
.stopkran-nav-tabs > li.active > a,
.stopkran-nav-tabs > li.active > a:focus,
.stopkran-nav-tabs > li.active > a:hover {
    background: #161b22 !important;
    color: #58a6ff !important;
    border-bottom: 2px solid #58a6ff !important;
}
.deck-body {
    padding: 24px;
}

/* Flat Chips */
.flat-chip {
    display: inline-block;
    padding: 2px 7px;
    border: 1px solid #30363d;
    background: #0d1117;
    border-radius: 0;
    font-size: 11px;
    font-family: ui-monospace, Consolas, monospace;
    font-weight: 600;
    color: #8b949e;
    margin-left: 6px;
}
.chip-cyan {
    border-color: #1f4268;
    background: #0c1b2b;
    color: #58a6ff;
}
.chip-amber {
    border-color: #5a3e1b;
    background: #251a0b;
    color: #d29922;
}

/* Form Controls */
.stopkran-form .control-label {
    color: #c9d1d9;
    font-size: 13px;
    font-weight: 600;
}
.stopkran-input {
    background: #0d1117 !important;
    border: 1px solid #30363d !important;
    border-radius: 0 !important;
    color: #f0f6fc !important;
    box-shadow: none !important;
    font-size: 13px;
    height: 38px;
}
.stopkran-input:focus {
    border-color: #58a6ff !important;
}
.stopkran-input-btn,
.stopkran-btn-copy,
.stopkran-btn-flat {
    background: #21262d !important;
    border: 1px solid #363b42 !important;
    border-radius: 0 !important;
    color: #c9d1d9 !important;
    box-shadow: none !important;
    font-size: 12px !important;
    font-weight: 600;
    padding: 8px 16px;
}
.stopkran-input-btn:hover,
.stopkran-btn-copy:hover,
.stopkran-btn-flat:hover {
    background: #30363d !important;
    color: #ffffff !important;
}
.form-caption {
    font-size: 12px;
    color: #8b949e;
    margin-top: 6px;
}
.section-divider {
    border-top: 1px solid #21262d;
    margin: 22px 0;
}

/* Tables */
.stopkran-data-table {
    border: 1px solid #30363d;
    border-radius: 0;
    margin-bottom: 0;
}
.stopkran-data-table > thead > tr > th {
    background: #0d1117;
    border-bottom: 1px solid #30363d !important;
    color: #8b949e;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 10px 14px;
}
.stopkran-data-table > tbody > tr > td {
    border-top: 1px solid #21262d;
    padding: 12px 14px;
    vertical-align: middle;
    color: #c9d1d9;
    font-size: 13px;
}
.stopkran-data-table tr.row-deactivated td {
    opacity: 0.45;
    background: #0f1319;
}
.cell-title {
    font-weight: 600;
    color: #f0f6fc !important;
}
.cell-code {
    background: #0d1117;
    border: 1px solid #30363d;
    padding: 2px 6px;
    color: #58a6ff;
    font-size: 12px;
}
.cell-meta {
    color: #8b949e;
    font-size: 12px;
}
.text-spec {
    color: #3fb950;
    font-size: 12px;
}
.text-meta {
    color: #8b949e;
    font-size: 12px;
}
.cell-empty {
    color: #6e7681;
    padding: 30px !important;
}

/* Tactile Industrial Rocker Switch (Physical Equipment Look) */
.rocker-switch-wrap {
    display: inline-block;
    position: relative;
    user-select: none;
}
.rocker-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
}
.rocker-label {
    display: flex;
    align-items: center;
    position: relative;
    width: 72px;
    height: 26px;
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 0;
    cursor: pointer;
    margin: 0;
    overflow: hidden;
}
.rocker-off,
.rocker-on {
    flex: 1;
    text-align: center;
    font-size: 10px;
    font-weight: 800;
    font-family: ui-monospace, Consolas, monospace;
    letter-spacing: 0.05em;
    z-index: 1;
    transition: color 0.1s ease;
}
.rocker-off {
    color: #f85149;
}
.rocker-on {
    color: #484f58;
}
.rocker-nub {
    position: absolute;
    top: 1px;
    left: 1px;
    width: 34px;
    height: 22px;
    background: #21262d;
    border: 1px solid #363b42;
    border-radius: 0;
    transition: transform 0.12s cubic-bezier(0.4, 0, 0.2, 1);
}
.rocker-input:checked + .rocker-label .rocker-nub {
    transform: translateX(34px);
    background: #0e2a1b;
    border-color: #238636;
}
.rocker-input:checked + .rocker-label .rocker-off {
    color: #484f58;
}
.rocker-input:checked + .rocker-label .rocker-on {
    color: #3fb950;
}

/* Terminal Log View */
.log-control-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}
.log-file-label {
    font-size: 12px;
    color: #8b949e;
}
.stopkran-terminal {
    background: #090d13;
    border: 1px solid #30363d;
    border-radius: 0;
    box-shadow: none;
    padding: 16px;
    max-height: 460px;
    overflow-y: auto;
}
.terminal-record {
    color: #c9d1d9;
    font-size: 12px;
    line-height: 1.6;
    padding: 3px 0;
    border-bottom: 1px solid #161b22;
    white-space: pre-wrap;
    word-break: break-all;
}
.terminal-empty {
    color: #6e7681;
    font-size: 12px;
    padding: 20px 0;
    text-align: center;
}
.font-mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
}
</style>

<script>
$(document).ready(function() {
    // 1. Copy URL Helper
    $('.btn-copy').on('click', function() {
        var targetSelector = $(this).data('target');
        var input = $(targetSelector);
        input.select();
        document.execCommand('copy');

        var btn = $(this);
        var oldHtml = btn.html();
        btn.html('<i class="fa fa-check"></i> {{ text_copied }}');
        setTimeout(function() {
            btn.html(oldHtml);
        }, 1800);
    });

    // 2. Generate Random Token
    $('#btn-gen-token').on('click', function() {
        var chars = '0123456789abcdef';
        var token = '';
        for (var i = 0; i < 32; i++) {
            token += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        $('#input-secret-token').val(token);
        var adminBase = '{{ bypass_url_admin }}'.split('?')[0];
        var catalogBase = '{{ bypass_url_catalog }}'.split('?')[0];
        $('#bypass-admin-url').val(adminBase + '?stopkran_kill_all=' + token);
        $('#bypass-catalog-url').val(catalogBase + '?stopkran_kill_all=' + token);
    });

    // 3. Master Emergency Stop-Kran (Total Blackout)
    $('#btn-master-kill').on('click', function() {
        if (!confirm('{{ text_confirm_blackout }}')) {
            return;
        }

        var btn = $(this);
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> ENGAGING...');

        $.ajax({
            url: '{{ url_kill_all }}',
            type: 'post',
            dataType: 'json',
            success: function(json) {
                if (json['error']) {
                    alert(json['error']);
                    btn.prop('disabled', false).html('<i class="fa fa-ban"></i> {{ button_kill_all }}');
                } else {
                    $('#ajax-alert').html('<div class="alert alert-danger stopkran-alert"><i class="fa fa-check-circle"></i> ' + json['message'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                    setTimeout(function() {
                        location.reload();
                    }, 1200);
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                btn.prop('disabled', false).html('<i class="fa fa-ban"></i> {{ button_kill_all }}');
            }
        });
    });

    // 4. AJAX Toggle Modification
    $('.ajax-toggle-mod').on('change', function() {
        var chk = $(this);
        var modId = chk.data('id');
        var newStatus = chk.is(':checked') ? 1 : 0;
        var row = $('#mod-row-' + modId);

        chk.prop('disabled', true);

        $.ajax({
            url: '{{ url_toggle_modification }}',
            type: 'post',
            data: { modification_id: modId, status: newStatus },
            dataType: 'json',
            success: function(json) {
                chk.prop('disabled', false);
                if (json['error']) {
                    alert(json['error']);
                    chk.prop('checked', !newStatus);
                } else {
                    if (newStatus) {
                        row.removeClass('row-deactivated');
                    } else {
                        row.addClass('row-deactivated');
                    }
                }
            },
            error: function() {
                chk.prop('disabled', false);
                chk.prop('checked', !newStatus);
            }
        });
    });

    // 5. AJAX Toggle Event
    $('.ajax-toggle-evt').on('change', function() {
        var chk = $(this);
        var evtId = chk.data('id');
        var newStatus = chk.is(':checked') ? 1 : 0;
        var row = $('#evt-row-' + evtId);

        chk.prop('disabled', true);

        $.ajax({
            url: '{{ url_toggle_event }}',
            type: 'post',
            data: { event_id: evtId, status: newStatus },
            dataType: 'json',
            success: function(json) {
                chk.prop('disabled', false);
                if (json['error']) {
                    alert(json['error']);
                    chk.prop('checked', !newStatus);
                } else {
                    if (newStatus) {
                        row.removeClass('row-deactivated');
                    } else {
                        row.addClass('row-deactivated');
                    }
                }
            },
            error: function() {
                chk.prop('disabled', false);
                chk.prop('checked', !newStatus);
            }
        });
    });

    // 6. Purge Caches Button
    $('#btn-purge-cache').on('click', function() {
        var btn = $(this);
        var oldHtml = btn.html();
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Purging...');

        $.ajax({
            url: '{{ url_purge_cache }}',
            type: 'post',
            dataType: 'json',
            success: function(json) {
                btn.prop('disabled', false).html(oldHtml);
                if (json['success']) {
                    $('#stat-cache').text('0.00 B');
                    $('#ajax-alert').html('<div class="alert alert-success stopkran-alert"><i class="fa fa-check-circle"></i> ' + json['message'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                } else if (json['error']) {
                    alert(json['error']);
                }
            },
            error: function() {
                btn.prop('disabled', false).html(oldHtml);
            }
        });
    });

    // 7. Clear Log Button
    $('#btn-clear-log').on('click', function() {
        if (!confirm('Clear crash diagnostics log?')) {
            return;
        }

        var btn = $(this);
        btn.prop('disabled', true);

        $.ajax({
            url: '{{ url_clear_log }}',
            type: 'post',
            dataType: 'json',
            success: function(json) {
                btn.prop('disabled', false);
                if (json['success']) {
                    $('#crash-log-container').html('<div class="terminal-empty font-mono">{{ text_no_logs }}</div>');
                } else if (json['error']) {
                    alert(json['error']);
                }
            },
            error: function() {
                btn.prop('disabled', false);
            }
        });
    });
});
</script>
{{ footer }}
