{{ header }}
<!-- Studio Breadcrumbs -->
<nav class="studio-breadcrumbs-bar" aria-label="breadcrumb">
  <div class="container">
    <ol class="studio-breadcrumbs-list">
      {% for breadcrumb in breadcrumbs %}
        {% if loop.last %}
          <li class="studio-breadcrumb-item active" aria-current="page">{{ breadcrumb.text }}</li>
        {% else %}
          <li class="studio-breadcrumb-item">
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
            <span class="studio-breadcrumb-sep">/</span>
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  </div>
</nav>

<div id="product-product" class="container studio-product-container">
  {{ content_top }}
  
  <div class="studio-product-hero">
    <!-- Left Column: Gallery & Audio Preview Showcase -->
    <div class="studio-product-gallery">
      <div class="studio-artwork-frame">
        {% if thumb %}
          <a class="studio-artwork-link" href="{{ popup }}" title="{{ heading_title }}" id="main-product-link">
            <img src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" class="studio-artwork-img" id="main-product-image" />
          </a>
        {% endif %}
        {% if is_music and format_badge %}
          <span class="studio-format-pill {{ format_badge == 'КОМПАКТ-ДИСК CD' ? 'pill-cd' : 'pill-vinyl' }}">{{ format_badge }}</span>
        {% endif %}
      </div>

      {% if images %}
        <div class="studio-thumb-strip">
          {% if thumb %}
            <div class="studio-thumb-item active" data-popup="{{ popup }}" data-preview="{{ thumb }}" data-index="0">
              <img src="{{ thumb_sm|default(thumb) }}" alt="{{ heading_title }}" />
            </div>
          {% endif %}
          {% for key, image in images %}
            <div class="studio-thumb-item" data-popup="{{ image.popup }}" data-preview="{{ image.preview|default(image.popup) }}" data-index="{{ key + (thumb ? 1 : 0) }}">
              <img src="{{ image.thumb }}" alt="{{ heading_title }}" />
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Audio Sample Player (only for musical releases) -->
      {% if is_music and preview_track %}
        <div class="studio-vinyl-preview-player" id="studio-preview-player">
          <div class="player-vinyl-disc-wrap">
            <div class="player-vinyl-disc" id="player-vinyl-disc"></div>
            <button type="button" class="btn-player-play" id="btn-studio-play" title="Прослушать сэмпл">
              <i class="fa fa-play" id="studio-play-icon"></i>
            </button>
          </div>
          <div class="player-info-wrap">
            <span class="player-eyebrow">Аудио-сэмпл трека #{{ preview_track.track_num }}</span>
            <div class="player-title">{{ preview_track.title }}</div>
            <div class="player-duration"><i class="fa fa-clock-o"></i> {{ preview_track.duration }}</div>
          </div>
          <audio id="studio-audio-element" preload="none">
            <source src="{{ preview_track.audio_url }}" type="audio/mpeg">
          </audio>
        </div>
      {% endif %}
    </div>

    <!-- Right Column: Product Information & Commercial Suite -->
    <div class="studio-product-details">
      <div class="studio-header-block">
        {% if artist %}
          <div class="studio-artist-tag">{{ artist|upper }}</div>
        {% endif %}
        <h1 class="studio-product-h1">{{ heading_title }}</h1>
        <div class="studio-meta-pills-row">
          {% if year %}<span class="studio-meta-pill"><i class="fa fa-calendar-o"></i> {{ year }}</span>{% endif %}
          {% if label %}<span class="studio-meta-pill"><i class="fa fa-tag"></i> {{ label }}</span>{% endif %}
          {% if manufacturer %}<span class="studio-meta-pill"><i class="fa fa-industry"></i> {{ manufacturer }}</span>{% endif %}
        </div>

        <!-- AI Mode Capsule Button (only for musical releases) -->
        {% if is_music %}
        <button type="button" class="btn-ai-mode btn-ai-mode--detail" data-product-id="{{ product_id }}" title="AI Mode • Похожие релизы">
          <svg class="ai-sparkle-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3l5.8 1.9-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3L12 3z"/>
          </svg>
          <span>AI Mode • Похожие релизы по звучанию</span>
        </button>
        {% endif %}
      </div>

      <!-- Commercial Suite Card -->
      <div class="studio-commercial-card" id="product">
        <div class="commercial-status-bar">
          <div class="commercial-sku">
            <span class="sku-label">Артикул:</span>
            <span class="sku-code">{{ model }}</span>
          </div>
          <div class="commercial-stock">
            <span class="stock-dot"></span>
            <span class="stock-text">{{ stock|default('В наличии') }}</span>
          </div>
        </div>

        {% if price %}
          <div class="commercial-price-bar">
            {% if not special %}
              <div class="commercial-main-price">{{ price }}</div>
            {% else %}
              <div class="commercial-main-price price--sale">{{ special }}</div>
              <div class="commercial-old-price">{{ price }}</div>
            {% endif %}
            {% if tax %}
              <span class="commercial-tax-note">{{ text_tax }} {{ tax }}</span>
            {% endif %}
          </div>
        {% endif %}

        <!-- Product Options (if any) -->
        {% if options %}
          <div class="commercial-options-wrap">
            {% for option in options %}
              {% if option.type == 'select' %}
                <div class="studio-option-group{% if option.required %} required{% endif %}">
                  <label class="studio-option-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
                  <select name="option[{{ option.product_option_id }}]" id="input-option{{ option.product_option_id }}" class="studio-select-control">
                    <option value="">{{ text_select }}</option>
                    {% for option_value in option.product_option_value %}
                      <option value="{{ option_value.product_option_value_id }}">{{ option_value.name }} {% if option_value.price %}({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}</option>
                    {% endfor %}
                  </select>
                </div>
              {% endif %}
              {% if option.type == 'radio' %}
                <div class="studio-option-group{% if option.required %} required{% endif %}">
                  <label class="studio-option-label">{{ option.name }}</label>
                  <div class="studio-option-pills" id="input-option{{ option.product_option_id }}">
                    {% for option_value in option.product_option_value %}
                      <label class="studio-pill-item">
                        <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}" />
                        <span class="pill-label">{{ option_value.name }} {% if option_value.price %}({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}</span>
                      </label>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <!-- Purchase Action Row -->
        <div class="commercial-purchase-row">
          <div class="studio-qty-stepper">
            <button type="button" class="stepper-btn" onclick="SoundnetStorefront.changeQty(-1);">&minus;</button>
            <input type="text" name="quantity" value="{{ minimum|default(1) }}" id="input-quantity" class="stepper-input" />
            <button type="button" class="stepper-btn" onclick="SoundnetStorefront.changeQty(1);">&plus;</button>
            <input type="hidden" name="product_id" value="{{ product_id }}" />
          </div>
          <button type="button" id="button-cart" data-loading-text="Добавление..." class="btn-studio-buy-main">
            <i class="fa fa-shopping-cart"></i>
            <span>Купить</span>
          </button>
        </div>

        <!-- Secondary Actions -->
        <div class="commercial-actions-row">
          <button type="button" class="btn-studio-secondary btn-wishlist-action" onclick="wishlist.add('{{ product_id }}');" title="В избранное">
            <i class="fa fa-heart-o"></i>
            <span>Добавить в избранное</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Studio Content Tabs -->
  <div class="studio-tabs-section">
    <div class="studio-tabs-nav">
      <button type="button" class="studio-tab-btn active" data-tab="tab-description">
        <span>Описание</span>
        {% if is_music and tracks %}<span class="tab-badge">{{ tracks|length }}</span>{% endif %}
      </button>
      {% if attribute_groups %}
        <button type="button" class="studio-tab-btn" data-tab="tab-specification">
          <span>Характеристики</span>
        </button>
      {% endif %}
      {% if review_status %}
        <button type="button" class="studio-tab-btn" data-tab="tab-review">
          <span>Отзывы</span>
          {% if reviews %}<span class="tab-badge">{{ reviews }}</span>{% endif %}
        </button>
      {% endif %}
    </div>

    <div class="studio-tabs-content">
      <!-- Description Tab -->
      <div class="studio-tab-pane active" id="tab-description">
        <div class="studio-prose-content">
          {{ description|raw }}
        </div>

        {% if is_music and tracks %}
          <div class="studio-tracklist-section{% if tracks|length > 8 %} is-collapsible is-collapsed{% endif %}" id="studio-tracklist-section" style="margin-top: 32px;">
            <div class="studio-tracklist-header-row">
              <h3 class="studio-block-header"><i class="fa fa-list-ol"></i> Треклист релиза <span class="tracklist-badge">{{ tracks|length }}</span></h3>
            </div>
            <div class="studio-tracklist-table-wrap">
              <table class="studio-tracklist-table">
                <thead>
                  <tr>
                    <th class="th-num">#</th>
                    <th class="th-title">Композиция</th>
                    <th class="th-duration"><i class="fa fa-clock-o"></i> Длительность</th>
                    <th class="th-action"></th>
                  </tr>
                </thead>
                <tbody>
                  {% for track in tracks %}
                    <tr class="track-row" data-audio-url="{{ track.audio_url }}">
                      <td class="td-num">{{ track.track_num }}</td>
                      <td class="td-title">
                        <span class="track-name">{{ track.title }}</span>
                      </td>
                      <td class="td-duration">{{ track.duration }}</td>
                      <td class="td-action">
                        {% if track.audio_url %}
                          <button type="button" class="btn-table-play" onclick="SoundnetStorefront.playAudio('{{ track.audio_url }}', '{{ track.title }}');" title="Слушать">
                            <i class="fa fa-play"></i>
                          </button>
                        {% endif %}
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            {% if tracks|length > 8 %}
              <div class="studio-tracklist-toggle-bar">
                <button type="button" class="btn-tracklist-toggle js-tracklist-toggle" data-count="{{ tracks|length }}" aria-expanded="false">
                  <span class="toggle-text-collapsed">
                    <i class="fa fa-chevron-down"></i> Показать все треки ({{ tracks|length }})
                  </span>
                  <span class="toggle-text-expanded">
                    <i class="fa fa-chevron-up"></i> Свернуть треклист
                  </span>
                </button>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <!-- Specification Tab -->
      {% if attribute_groups %}
        <div class="studio-tab-pane" id="tab-specification">
          <div class="studio-specs-section">
            <h3 class="studio-block-header"><i class="fa fa-sliders"></i> Характеристики и параметры</h3>
            <div class="studio-specs-grid">
              {% for attribute_group in attribute_groups %}
                {% for attribute in attribute_group.attribute %}
                  <div class="studio-spec-card">
                    <div class="spec-label">{{ attribute.name }}</div>
                    <div class="spec-val">{{ attribute.text }}</div>
                  </div>
                {% endfor %}
              {% endfor %}
            </div>
          </div>
        </div>
      {% endif %}

      <!-- Reviews Tab -->
      {% if review_status %}
        <div class="studio-tab-pane" id="tab-review">
          <div class="studio-reviews-container">
            <div id="review" class="studio-reviews-feed"></div>

            <form class="studio-review-form" id="form-review">
              <h3 class="studio-block-header">{{ is_music ? 'Оставить отзыв о релизе' : 'Оставить отзыв о товаре' }}</h3>
              {% if review_guest %}
                <div class="studio-form-row">
                  <label class="studio-form-label" for="input-name">Ваше имя *</label>
                  <input type="text" name="name" value="{{ customer_name }}" id="input-name" class="studio-form-input" placeholder="Иван Петров" />
                </div>
                <div class="studio-form-row">
                  <label class="studio-form-label" for="input-review">Ваш отзыв *</label>
                  <textarea name="text" rows="4" id="input-review" class="studio-form-textarea" placeholder="{{ is_music ? 'Поделитесь впечатлениями о звучании, мастеринге или качестве прессинга...' : 'Поделитесь впечатлениями о качестве товара...' }}"></textarea>
                  <span class="studio-form-hint">Минимум 25 символов. HTML-разметка не поддерживается.</span>
                </div>
                <div class="studio-form-row">
                  <label class="studio-form-label">Ваша оценка *</label>
                  <div class="studio-rating-stars" id="star-rating-widget">
                    <span class="rating-star" data-value="1"><i class="fa fa-star"></i></span>
                    <span class="rating-star" data-value="2"><i class="fa fa-star"></i></span>
                    <span class="rating-star" data-value="3"><i class="fa fa-star"></i></span>
                    <span class="rating-star" data-value="4"><i class="fa fa-star"></i></span>
                    <span class="rating-star active" data-value="5"><i class="fa fa-star"></i></span>
                    <input type="hidden" name="rating" id="input-rating-val" value="5" />
                  </div>
                </div>
                {{ captcha }}
                <div class="studio-form-submit-row">
                  <button type="button" id="button-review" data-loading-text="Отправка..." class="btn-studio-submit-review">
                    <i class="fa fa-paper-plane"></i>
                    <span>Опубликовать отзыв</span>
                  </button>
                </div>
              {% else %}
                <div class="studio-guest-login-notice">{{ text_login }}</div>
              {% endif %}
            </form>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Matching Gear Section -->
  {% if is_music and matching_gear %}
    <section class="matching-gear-block">
      <div class="matching-gear-block__header">
        <div class="matching-gear-block__eyebrow">Студийный сетап и оборудование</div>
        <h3 class="matching-gear-block__title">Инструменты для этой песни</h3>
        <p class="matching-gear-block__subtitle">Оборудование и инструменты, формирующие фирменное звучание этого релиза</p>
      </div>
      <div class="matching-gear-grid">
        {% for gear in matching_gear %}
          <div class="gear-item-card">
            <div class="gear-item-card__media">
              <a href="{{ gear.href }}"><img src="{{ gear.thumb }}" alt="{{ gear.name }}" loading="lazy" /></a>
              {% if gear.brand %}<span class="gear-item-card__brand">{{ gear.brand }}</span>{% endif %}
            </div>
            <div class="gear-item-card__body">
              <div class="gear-item-card__type">{{ gear.gear_type }}</div>
              <h4 class="gear-item-card__title"><a href="{{ gear.href }}">{{ gear.name }}</a></h4>
              {% if gear.sound_style %}<div class="gear-item-card__style"><i class="fa fa-sliders"></i> {{ gear.sound_style }}</div>{% endif %}
              <div class="gear-item-card__action-row">
                <span class="gear-item-card__price">{{ gear.price }}</span>
                <button type="button" class="btn-gear-buy" onclick="cart.add('{{ gear.product_id }}', 1);">Купить</button>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <!-- Related Products (if any) -->
  {% if products %}
    <section class="matching-gear-block studio-related-block">
      <div class="matching-gear-block__header">
        <div class="matching-gear-block__eyebrow">Рекомендации магазина</div>
        <h3 class="matching-gear-block__title">Похожие товары</h3>
      </div>
      <div class="matching-gear-grid">
        {% for rel in products %}
          <div class="gear-item-card">
            <div class="gear-item-card__media">
              <a href="{{ rel.href }}"><img src="{{ rel.thumb }}" alt="{{ rel.name }}" loading="lazy" /></a>
            </div>
            <div class="gear-item-card__body">
              <h4 class="gear-item-card__title"><a href="{{ rel.href }}">{{ rel.name }}</a></h4>
              <div class="gear-item-card__action-row">
                <span class="gear-item-card__price">{{ rel.price }}</span>
                <button type="button" class="btn-gear-buy" onclick="cart.add('{{ rel.product_id }}', 1);">Купить</button>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {{ content_bottom }}
</div>

<script type="text/javascript"><!--
// Quantity Stepper
SoundnetStorefront.changeQty = function(delta) {
  var input = document.getElementById('input-quantity');
  if (!input) return;
  var val = parseInt(input.value, 10) || 1;
  val += delta;
  if (val < 1) val = 1;
  input.value = val;
};

// Play audio from tracklist or preview player
SoundnetStorefront.playAudio = function(url, title) {
  var audio = document.getElementById('studio-audio-element');
  var playBtn = document.getElementById('btn-studio-play');
  var disc = document.getElementById('player-vinyl-disc');
  if (!audio) {
    audio = new Audio(url);
  } else {
    audio.src = url;
  }
  audio.play().then(function() {
    if (playBtn) playBtn.innerHTML = '<i class="fa fa-pause"></i>';
    if (disc) disc.classList.add('is-spinning');
  }).catch(function(err) {
    console.log('Audio playback prevented:', err);
  });
};

// Studio Tabs Switching
document.querySelectorAll('.studio-tab-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.studio-tab-btn').forEach(function(b) { b.classList.remove('active'); });
    document.querySelectorAll('.studio-tab-pane').forEach(function(p) { p.classList.remove('active'); });
    this.classList.add('active');
    var tabId = this.getAttribute('data-tab');
    var pane = document.getElementById(tabId);
    if (pane) {
      pane.classList.add('active');
      if (tabId === 'tab-review') {
        $('#review').load('index.php?route=product/product/review&product_id={{ product_id }}');
      }
    }
  });
});

// Tracklist Collapsible Full View / Less View Toggle
document.querySelectorAll('.js-tracklist-toggle').forEach(function(btn) {
  btn.addEventListener('click', function(e) {
    e.preventDefault();
    var section = this.closest('.studio-tracklist-section');
    if (!section) return;
    var isCollapsed = section.classList.contains('is-collapsed');
    if (isCollapsed) {
      section.classList.remove('is-collapsed');
      this.setAttribute('aria-expanded', 'true');
    } else {
      section.classList.add('is-collapsed');
      this.setAttribute('aria-expanded', 'false');
      var rect = section.getBoundingClientRect();
      if (rect.top < 80) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  });
});


// Thumbnail Image Switching & Lightbox Gallery
var activeGalleryIndex = 0;
var galleryItems = [];
{% if popup %}
galleryItems.push({ src: '{{ popup }}', title: '{{ heading_title|escape('js') }}' });
{% endif %}
{% for image in images %}
galleryItems.push({ src: '{{ image.popup }}', title: '{{ heading_title|escape('js') }}' });
{% endfor %}

document.querySelectorAll('.studio-thumb-item').forEach(function(item) {
  item.addEventListener('click', function() {
    document.querySelectorAll('.studio-thumb-item').forEach(function(t) { t.classList.remove('active'); });
    this.classList.add('active');
    activeGalleryIndex = parseInt(this.getAttribute('data-index') || 0, 10);
    var preview = this.getAttribute('data-preview') || this.getAttribute('data-popup');
    var popup = this.getAttribute('data-popup');
    var img = document.getElementById('main-product-image');
    var link = document.getElementById('main-product-link');
    if (img && preview) {
      img.src = preview;
    }
    if (link && popup) {
      link.href = popup;
    }
  });
});

// Interactive Star Rating Picker
document.querySelectorAll('#star-rating-widget .rating-star').forEach(function(star) {
  star.addEventListener('click', function() {
    var val = parseInt(this.getAttribute('data-value'), 10);
    document.getElementById('input-rating-val').value = val;
    document.querySelectorAll('#star-rating-widget .rating-star').forEach(function(s) {
      var sVal = parseInt(s.getAttribute('data-value'), 10);
      if (sVal <= val) {
        s.classList.add('active');
      } else {
        s.classList.remove('active');
      }
    });
  });
});

// Mini Player Play/Pause
var playBtn = document.getElementById('btn-studio-play');
var audioEl = document.getElementById('studio-audio-element');
var vinylDisc = document.getElementById('player-vinyl-disc');
if (playBtn && audioEl) {
  playBtn.addEventListener('click', function() {
    if (audioEl.paused) {
      audioEl.play().then(function() {
        playBtn.innerHTML = '<i class="fa fa-pause"></i>';
        if (vinylDisc) vinylDisc.classList.add('is-spinning');
      }).catch(function(e) { console.log(e); });
    } else {
      audioEl.pause();
      playBtn.innerHTML = '<i class="fa fa-play"></i>';
      if (vinylDisc) vinylDisc.classList.remove('is-spinning');
    }
  });
  audioEl.addEventListener('ended', function() {
    playBtn.innerHTML = '<i class="fa fa-play"></i>';
    if (vinylDisc) vinylDisc.classList.remove('is-spinning');
  });
}

// OpenCart Native AJAX Cart Add
$('#button-cart').on('click', function() {
  $.ajax({
    url: 'index.php?route=checkout/cart/add',
    type: 'post',
    data: $('#product input[type=\'text\'], #product input[type=\'hidden\'], #product input[type=\'radio\']:checked, #product input[type=\'checkbox\']:checked, #product select, #product textarea'),
    dataType: 'json',
    beforeSend: function() {
      $('#button-cart').button('loading');
    },
    complete: function() {
      $('#button-cart').button('reset');
    },
    success: function(json) {
      $('.alert-dismissible, .text-danger').remove();
      $('.studio-option-group').removeClass('has-error');

      if (json['error']) {
        if (json['error']['option']) {
          for (var i in json['error']['option']) {
            var element = $('#input-option' + i.replace('_', '-'));
            element.after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
          }
        }
      }

      if (json['success']) {
        $('.studio-breadcrumbs-bar').after('<div class="alert alert-success alert-dismissible container" style="margin-top:15px;"><i class="fa fa-check-circle"></i> ' + json['success'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
        if ($('#cart-total').length) {
          $('#cart-total').html(json['total']);
        } else {
          $('#cart > button').html('<span id="cart-total"><i class="fa fa-shopping-cart"></i> ' + json['total'] + '</span>');
        }
        if (window.SoundnetStorefront && window.SoundnetStorefront.syncCartUI) {
          window.SoundnetStorefront.syncCartUI();
        }
        $('html, body').animate({ scrollTop: 0 }, 'slow');
        $('#cart > ul').load('index.php?route=common/cart/info ul li');
      }
    },
    error: function(xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
});

// Reviews Pagination & Loading
$('#review').delegate('.pagination a', 'click', function(e) {
  e.preventDefault();
  $('#review').fadeOut('slow');
  $('#review').load(this.href);
  $('#review').fadeIn('slow');
});
$('#review').load('index.php?route=product/product/review&product_id={{ product_id }}');

// OpenCart Review Submission
$('#button-review').on('click', function() {
  $.ajax({
    url: 'index.php?route=product/product/write&product_id={{ product_id }}',
    type: 'post',
    dataType: 'json',
    data: $("#form-review").serialize(),
    beforeSend: function() {
      $('#button-review').button('loading');
    },
    complete: function() {
      $('#button-review').button('reset');
    },
    success: function(json) {
      $('.alert-dismissible').remove();
      if (json['error']) {
        $('#review').after('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + '</div>');
      }
      if (json['success']) {
        $('#review').after('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['success'] + '</div>');
        $('input[name=\'name\']').val('');
        $('textarea[name=\'text\']').val('');
      }
    }
  });
});

$(document).ready(function() {
  $('#main-product-link').on('click', function(e) {
    e.preventDefault();
    if (galleryItems.length > 0) {
      $.magnificPopup.open({
        items: galleryItems,
        type: 'image',
        gallery: { enabled: true },
        removalDelay: 200,
        mainClass: 'mfp-fade'
      }, activeGalleryIndex);
    }
  });
});
