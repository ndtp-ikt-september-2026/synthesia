{{ header }}
<!-- Studio Breadcrumbs -->
<nav class="studio-breadcrumbs-bar" aria-label="breadcrumb">
  <div class="container">
    <ol class="studio-breadcrumbs-list">
      {% for breadcrumb in breadcrumbs %}
        {% if loop.last %}
          <li class="studio-breadcrumb-item active" aria-current="page">{{ breadcrumb.text }}</li>
        {% else %}
          <li class="studio-breadcrumb-item">
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
            <span class="studio-breadcrumb-sep">/</span>
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  </div>
</nav>

<div id="information-sitemap" class="container studio-product-container">
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
      {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
      {% set class = 'col-sm-9' %}
    {% else %}
      {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <div class="studio-content-card" style="margin-bottom: 30px;">
        <h1 class="studio-category-heading" style="margin-top: 0; margin-bottom: 24px;">{{ heading_title }}</h1>
        <div class="row">
          <div class="col-sm-6" style="margin-bottom: 20px;">
            <h3 class="studio-card-section-title">Каталог товаров</h3>
            <ul class="studio-sitemap-list" style="line-height: 2; padding-left: 20px;">
              {% for category_1 in categories %}
              <li><a href="{{ category_1.href }}" style="font-weight: 700; color: #0f172a;">{{ category_1.name }}</a>
                {% if category_1.children %}
                <ul style="padding-left: 20px;">
                  {% for category_2 in category_1.children %}
                  <li><a href="{{ category_2.href }}" style="color: #475569;">{{ category_2.name }}</a>
                    {% if category_2.children %}
                    <ul style="padding-left: 20px;">
                      {% for category_3 in category_2.children %}
                      <li><a href="{{ category_3.href }}" style="color: #64748b;">{{ category_3.name }}</a></li>
                      {% endfor %}
                    </ul>
                    {% endif %}
                  </li>
                  {% endfor %}
                </ul>
                {% endif %}
              </li>
              {% endfor %}
            </ul>
          </div>
          <div class="col-sm-6" style="margin-bottom: 20px;">
            <h3 class="studio-card-section-title">Сервисы и навигация</h3>
            <ul class="studio-sitemap-list" style="line-height: 2; padding-left: 20px;">
              <li><a href="{{ special }}" style="font-weight: 700; color: #0f172a;">{{ text_special }}</a></li>
              <li><a href="{{ account }}" style="font-weight: 700; color: #0f172a;">{{ text_account }}</a>
                <ul style="padding-left: 20px;">
                  <li><a href="{{ edit }}" style="color: #475569;">{{ text_edit }}</a></li>
                  <li><a href="{{ password }}" style="color: #475569;">{{ text_password }}</a></li>
                  <li><a href="{{ address }}" style="color: #475569;">{{ text_address }}</a></li>
                  <li><a href="{{ history }}" style="color: #475569;">{{ text_history }}</a></li>
                  <li><a href="{{ download }}" style="color: #475569;">{{ text_download }}</a></li>
                </ul>
              </li>
              <li><a href="{{ history }}" style="font-weight: 700; color: #0f172a;">{{ text_cart }}</a></li>
              <li><a href="{{ checkout }}" style="font-weight: 700; color: #0f172a;">{{ text_checkout }}</a></li>
              <li><a href="{{ search }}" style="font-weight: 700; color: #0f172a;">{{ text_search }}</a></li>
              <li><span style="font-weight: 700; color: #0f172a;">{{ text_information }}</span>
                <ul style="padding-left: 20px;">
                  {% for information in informations %}
                  <li><a href="{{ information.href }}" style="color: #475569;">{{ information.title }}</a></li>
                  {% endfor %}
                  <li><a href="{{ contact }}" style="color: #475569;">{{ text_contact }}</a></li>
                </ul>
              </li>
            </ul>
          </div>
        </div>
      </div>
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}