{% if products %}
<div class="studio-module-section">
  <div class="studio-module-header">
    <h3 class="studio-module-title">{{ heading_title }}</h3>
  </div>
  <div class="row category-products-grid">
    {% for product in products %}
      <div class="product-layout col-lg-3 col-md-4 col-sm-6 col-xs-6">
        <div class="studio-search-card">
          <div class="image">
            <a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-responsive" loading="lazy" /></a>
            {% if product.special %}
              <span class="special-discount-badge">Sale</span>
            {% endif %}
          </div>
          <div class="caption">
            <h4><a href="{{ product.href }}" title="{{ product.name }}">{{ product.name }}</a></h4>
            {% if product.price %}
              <p class="price">
                {% if not product.special %}
                  <span class="price-normal">{{ product.price }}</span>
                {% else %}
                  <span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>
                {% endif %}
              </p>
            {% endif %}
          </div>
          <div class="studio-search-card__actions">
            <button type="button" class="btn-search-cart" onclick="cart.add('{{ product.product_id }}');" title="Купить">
              <i class="fa fa-shopping-cart"></i> <span>Купить</span>
            </button>
            <button type="button" class="btn-search-icon" data-toggle="tooltip" title="В избранное" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa fa-heart-o"></i></button>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
{% endif %}